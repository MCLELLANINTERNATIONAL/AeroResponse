@page "/Account/Login"
@layout AeroResponse.Components.Account.Shared.AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using MongoDB.Driver

@using AeroResponse.Data
@using AeroResponse.Data.Mongo
@using AeroResponse.Data.Mongo.Accounts

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject MongoDbContext MongoDbContext
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Sign in | AeroResponse</PageTitle>

<section class="login-card">

    <header class="login-heading">

        <p class="login-eyebrow">
            AeroResponse Training Portal
        </p>

        <h1>
            Welcome Back
        </h1>

        <p>
            Sign in to continue your training journey.
        </p>

    </header>

    <StatusMessage Message="@errorMessage" />

    <EditForm
        EditContext="editContext"
        method="post"
        OnSubmit="LoginUser"
        FormName="login"
        class="login-form">

        <DataAnnotationsValidator />

        <ValidationSummary
            class="validation-summary"
            role="alert" />

        <div class="auth-field">

            <label for="Input.Email">
                Email Address
            </label>

            <div class="auth-input-wrapper">

                <InputText
                    @bind-Value="Input.Email"
                    id="Input.Email"
                    class="auth-input"
                    autocomplete="username webauthn"
                    aria-required="true"
                    placeholder="Enter your email" />

                <svg
                    class="auth-input-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <path d="M3 5h18v14H3z" />

                    <path d="m3 7 9 6 9-6" />

                </svg>

            </div>

            <ValidationMessage
                For="() => Input.Email"
                class="validation-message" />

        </div>

        <div class="auth-field">

            <label for="Input.Password">
                Password
            </label>

            <div class="auth-input-wrapper">

                <InputText
                    type="@passwordInputType"
                    @bind-Value="Input.Password"
                    id="Input.Password"
                    class="auth-input auth-input-password"
                    autocomplete="current-password"
                    aria-required="true"
                    placeholder="Enter your password" />

                <svg
                    class="auth-input-icon auth-lock-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <rect
                        x="5"
                        y="10"
                        width="14"
                        height="10"
                        rx="2" />

                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />

                </svg>

                <button
                    type="button"
                    class="password-toggle"
                    aria-label="@passwordToggleLabel"
                    title="@passwordToggleLabel"
                    @onclick="TogglePasswordVisibility">

                    @if (showPassword)
                    {
                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true">

                            <path d="M3 3l18 18" />

                            <path
                                d="M10.6 10.7a2 2 0 0 0 2.7 2.7" />

                            <path
                                d="M9.9 4.2A10.8 10.8 0 0 1 12 4c5.5 0 9 5 9 5a16 16 0 0 1-2.4 2.9" />

                            <path
                                d="M6.6 6.6C4.3 8.1 3 10 3 10s3.5 5 9 5c1.2 0 2.3-.2 3.3-.6" />

                        </svg>
                    }
                    else
                    {
                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true">

                            <path
                                d="M3 12s3.5-5 9-5 9 5 9 5-3.5 5-9 5-9-5-9-5Z" />

                            <circle
                                cx="12"
                                cy="12"
                                r="2.5" />

                        </svg>
                    }

                </button>

            </div>

            <ValidationMessage
                For="() => Input.Password"
                class="validation-message" />

        </div>

        <div class="login-options">

            <label class="remember-option">

                <InputCheckbox
                    @bind-Value="Input.RememberMe"
                    class="remember-checkbox" />

                <span>
                    Remember me
                </span>

            </label>

            <a
                href="/Account/ForgotPassword"
                class="forgot-password-link">

                Forgot password?

            </a>

        </div>

        <button
            type="submit"
            class="primary-auth-button">

            <img
                src="/images/aircraft.png"
                alt=""
                aria-hidden="true" />

            <span>
                Sign In
            </span>

        </button>

        <div class="auth-divider">

            <span>
                or continue with
            </span>

        </div>

        <ExternalLoginPicker />

        <div class="passkey-area">

            <PasskeySubmit
                Operation="PasskeyOperation.Request"
                Name="Input.Passkey"
                EmailName="Input.Email"
                class="passkey-button">

                Sign in with a passkey

            </PasskeySubmit>

        </div>

        <p class="auth-switch-message">

            Don’t have an account?

            <a href="@RegisterUrl">
                Sign up
            </a>

        </p>

        <p class="confirmation-link">

            <a href="/Account/ResendEmailConfirmation">
                Resend email confirmation
            </a>

        </p>

    </EditForm>

</section>

@code {

    private const string MongoUserCollectionName =
        "userAccounts";


    private string? errorMessage;


    private EditContext editContext =
        default!;


    private bool showPassword;


    [CascadingParameter]
    private HttpContext HttpContext
    {
        get;
        set;
    } = default!;


    [SupplyParameterFromForm]
    private InputModel Input
    {
        get;
        set;
    } = default!;


    [SupplyParameterFromQuery]
    private string? ReturnUrl
    {
        get;
        set;
    }


    private string passwordInputType =>
        showPassword
            ? "text"
            : "password";


    private string passwordToggleLabel =>
        showPassword
            ? "Hide password"
            : "Show password";


    private string RegisterUrl =>
        NavigationManager
            .GetUriWithQueryParameters(
                "/Account/Register",
                new Dictionary<string, object?>
                {
                    ["ReturnUrl"] =
                        ReturnUrl
                });


    protected override async Task OnInitializedAsync()
    {
        Input ??=
            new InputModel();


        editContext =
            new EditContext(Input);


        if (HttpMethods.IsGet(
                HttpContext.Request.Method))
        {
            await HttpContext.SignOutAsync(
                IdentityConstants.ExternalScheme);
        }
    }


    public async Task LoginUser()
    {
        errorMessage = null;


        /*
         * =================================================
         * PASSKEY LOGIN
         * =================================================
         *
         * Passkeys still use ASP.NET Identity directly.
         *
         * Normal email/password login below uses MongoDB
         * as the authoritative account database.
         * =================================================
         */


        if (!string.IsNullOrEmpty(
                Input.Passkey?.Error))
        {
            errorMessage =
                $"Error: {Input.Passkey.Error}";

            return;
        }


        if (!string.IsNullOrEmpty(
                Input.Passkey?.CredentialJson))
        {
            var passkeyResult =
                await SignInManager
                    .PasskeySignInAsync(
                        Input.Passkey
                            .CredentialJson);


            await HandleIdentitySignInResultAsync(
                passkeyResult);


            return;
        }


        /*
         * =================================================
         * VALIDATE LOGIN FORM
         * =================================================
         */


        if (!editContext.Validate())
        {
            return;
        }


        var email =
            Input.Email
                .Trim();


        var password =
            Input.Password;


        /*
         * =================================================
         * STEP 1
         *
         * FIND THE ACCOUNT IN MONGODB
         *
         * MongoDB is the source of truth.
         *
         * If the account does not exist in MongoDB, the
         * login fails even if SQLite happens to contain a
         * matching Identity user.
         * =================================================
         */


        MongoUserAccount? mongoAccount;


        try
        {
            mongoAccount =
                await FindMongoAccountByEmailAsync(
                    email);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unable to query MongoDB during login for {Email}.",
                email);


            errorMessage =
                "Error: Login is temporarily unavailable. " +
                "Please try again.";


            return;
        }


        if (mongoAccount is null)
        {
            Logger.LogWarning(
                "Login rejected because MongoDB does not contain an account for {Email}.",
                email);


            errorMessage =
                "Error: The email address or password is incorrect.";


            return;
        }


        /*
         * =================================================
         * STEP 2
         *
         * CHECK THAT MONGODB HAS A PASSWORD HASH
         * =================================================
         */


        if (string.IsNullOrWhiteSpace(
                mongoAccount.PasswordHash))
        {
            Logger.LogWarning(
                "MongoDB account {Email} does not contain a password hash.",
                email);


            errorMessage =
                "Error: This account does not have a valid password configured.";


            return;
        }


        /*
         * =================================================
         * STEP 3
         *
         * VERIFY PASSWORD AGAINST THE HASH STORED IN MONGO
         *
         * SQLite is NOT used to decide whether the
         * password is correct.
         * =================================================
         */


        var passwordVerificationUser =
            BuildPasswordVerificationUser(
                mongoAccount);


        var verificationResult =
            UserManager
                .PasswordHasher
                .VerifyHashedPassword(
                    passwordVerificationUser,
                    mongoAccount.PasswordHash,
                    password);


        var passwordIsValid =
            verificationResult ==
                PasswordVerificationResult.Success ||
            verificationResult ==
                PasswordVerificationResult
                    .SuccessRehashNeeded;


        if (!passwordIsValid)
        {
            Logger.LogWarning(
                "MongoDB password validation failed for {Email}.",
                email);


            errorMessage =
                "Error: The email address or password is incorrect.";


            return;
        }


        Logger.LogInformation(
            "MongoDB authentication succeeded for {Email}.",
            email);


        /*
         * =================================================
         * STEP 4
         *
         * LOOK FOR THE ASP.NET IDENTITY USER IN SQLITE
         * =================================================
         *
         * We first use the IdentityUserId stored by Mongo.
         *
         * We also check email as a fallback in case an old
         * local account exists.
         * =================================================
         */


        ApplicationUser? identityUser;


        try
        {
            identityUser =
                await FindIdentityUserAsync(
                    mongoAccount);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "MongoDB login succeeded for {Email}, but the local Identity user could not be queried.",
                email);


            errorMessage =
                "Error: Your account was verified, but the local login profile could not be loaded.";


            return;
        }


        /*
         * =================================================
         * STEP 5
         *
         * IF THE USER IS NOT IN SQLITE, CREATE IT
         * =================================================
         */


        if (identityUser is null)
        {
            identityUser =
                await CreateIdentityUserFromMongoAsync(
                    mongoAccount);


            if (identityUser is null)
            {
                return;
            }
        }
        else
        {
            /*
             * =============================================
             * USER ALREADY EXISTS LOCALLY
             *
             * Synchronise the profile and password hash
             * with MongoDB.
             * =============================================
             */


            var synchronized =
                await SynchronizeIdentityUserAsync(
                    identityUser,
                    mongoAccount);


            if (!synchronized)
            {
                return;
            }
        }


        /*
         * =================================================
         * STEP 6
         *
         * CREATE THE NORMAL ASP.NET IDENTITY SESSION
         *
         * We use SignInAsync rather than
         * PasswordSignInAsync because the password was
         * already verified against MongoDB.
         * =================================================
         */


        try
        {
            await SignInManager.SignInAsync(
                identityUser,
                Input.RememberMe);


            Logger.LogInformation(
                "User {Email} signed in successfully through MongoDB authentication.",
                email);


            RedirectManager.RedirectTo(
                ReturnUrl);
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "MongoDB authentication succeeded for {Email}, but ASP.NET Identity could not create the login session.",
                email);


            errorMessage =
                "Error: Your account was verified, but the login session could not be created.";
        }
    }


    /*
     * =====================================================
     * MONGODB LOOKUP
     * =====================================================
     */


    private async Task<MongoUserAccount?>
        FindMongoAccountByEmailAsync(
            string email)
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            return null;
        }


        var normalizedEmail =
            email
                .Trim()
                .ToUpperInvariant();


        var collection =
            MongoDbContext
                .GetCollection<MongoUserAccount>(
                    MongoUserCollectionName);


        return await collection
            .Find(
                account =>
                    account.NormalizedEmail ==
                    normalizedEmail)
            .FirstOrDefaultAsync();
    }


    /*
     * =====================================================
     * BUILD TEMPORARY USER FOR PASSWORD VERIFICATION
     * =====================================================
     */


    private static ApplicationUser
        BuildPasswordVerificationUser(
            MongoUserAccount mongoAccount)
    {
        return new ApplicationUser
        {
            Id =
                mongoAccount.IdentityUserId,

            UserName =
                mongoAccount.Email,

            NormalizedUserName =
                mongoAccount.NormalizedEmail,

            Email =
                mongoAccount.Email,

            NormalizedEmail =
                mongoAccount.NormalizedEmail,

            FirstName =
                mongoAccount.FirstName,

            Surname =
                mongoAccount.Surname,

            PasswordHash =
                mongoAccount.PasswordHash
        };
    }


    /*
     * =====================================================
     * FIND LOCAL SQLITE IDENTITY USER
     * =====================================================
     */


    private async Task<ApplicationUser?>
        FindIdentityUserAsync(
            MongoUserAccount mongoAccount)
    {
        /*
         * Mongo's IdentityUserId should be the preferred
         * lookup because your reports, permissions and
         * company links all use this ID.
         */


        if (!string.IsNullOrWhiteSpace(
                mongoAccount.IdentityUserId))
        {
            var userById =
                await UserManager
                    .FindByIdAsync(
                        mongoAccount
                            .IdentityUserId);


            if (userById is not null)
            {
                return userById;
            }
        }


        /*
         * Also check for an existing local user using the
         * same email.
         */


        if (!string.IsNullOrWhiteSpace(
                mongoAccount.Email))
        {
            var userByEmail =
                await UserManager
                    .FindByEmailAsync(
                        mongoAccount.Email);


            if (userByEmail is not null)
            {
                /*
                 * The Mongo account and local Identity
                 * record must represent the same identity.
                 *
                 * If the IDs differ, signing in as the
                 * SQLite ID would break MongoDB permissions
                 * because ClaimTypes.NameIdentifier would
                 * no longer match IdentityUserId in Mongo.
                 */


                if (!string.IsNullOrWhiteSpace(
                        mongoAccount.IdentityUserId) &&
                    !string.Equals(
                        userByEmail.Id,
                        mongoAccount.IdentityUserId,
                        StringComparison.OrdinalIgnoreCase))
                {
                    Logger.LogError(
                        "Identity ID mismatch for {Email}. MongoDB ID is {MongoId}, but SQLite ID is {SqliteId}.",
                        mongoAccount.Email,
                        mongoAccount.IdentityUserId,
                        userByEmail.Id);


                    errorMessage =
                        "Error: This account exists locally with a different user ID. " +
                        "Remove the conflicting local Identity account and try again.";


                    return null;
                }


                return userByEmail;
            }
        }


        return null;
    }


    /*
     * =====================================================
     * CREATE SQLITE IDENTITY USER FROM MONGODB
     * =====================================================
     */


    private async Task<ApplicationUser?>
        CreateIdentityUserFromMongoAsync(
            MongoUserAccount mongoAccount)
    {
        if (!string.IsNullOrWhiteSpace(
                errorMessage))
        {
            /*
             * FindIdentityUserAsync detected an Identity
             * ID conflict.
             *
             * Do not create another user.
             */


            return null;
        }


        if (string.IsNullOrWhiteSpace(
                mongoAccount.IdentityUserId))
        {
            Logger.LogError(
                "MongoDB account {Email} is missing IdentityUserId.",
                mongoAccount.Email);


            errorMessage =
                "Error: This MongoDB account is missing its Identity user ID.";


            return null;
        }


        if (string.IsNullOrWhiteSpace(
                mongoAccount.Email))
        {
            Logger.LogError(
                "MongoDB account {IdentityUserId} is missing its email address.",
                mongoAccount.IdentityUserId);


            errorMessage =
                "Error: This MongoDB account is missing its email address.";


            return null;
        }


        var identityUser =
            new ApplicationUser
            {
                /*
                 * Keep the exact same ID stored in MongoDB.
                 *
                 * This is essential because the account
                 * permission system looks up Mongo records
                 * using the authenticated Identity user ID.
                 */


                Id =
                    mongoAccount.IdentityUserId,

                UserName =
                    mongoAccount.Email.Trim(),

                Email =
                    mongoAccount.Email.Trim(),

                EmailConfirmed =
                    true,

                FirstName =
                    mongoAccount.FirstName,

                Surname =
                    mongoAccount.Surname,

                /*
                 * Copy the ASP.NET Identity-compatible hash
                 * that already exists in MongoDB.
                 */


                PasswordHash =
                    mongoAccount.PasswordHash,

                SecurityStamp =
                    Guid.NewGuid()
                        .ToString(),

                ConcurrencyStamp =
                    Guid.NewGuid()
                        .ToString()
            };


        var createResult =
            await UserManager
                .CreateAsync(
                    identityUser);


        if (!createResult.Succeeded)
        {
            var errors =
                string.Join(
                    "; ",
                    createResult.Errors
                        .Select(
                            error =>
                                $"{error.Code}: {error.Description}"));


            Logger.LogError(
                "MongoDB authentication succeeded for {Email}, but the Identity record could not be created. {Errors}",
                mongoAccount.Email,
                errors);


            errorMessage =
                "Error: Your MongoDB login was valid, but the local Identity account could not be created. " +
                errors;


            return null;
        }


        Logger.LogInformation(
            "Created local Identity user {IdentityUserId} for MongoDB account {Email}.",
            identityUser.Id,
            identityUser.Email);


        return identityUser;
    }


    /*
     * =====================================================
     * SYNCHRONISE EXISTING SQLITE USER WITH MONGODB
     * =====================================================
     */


    private async Task<bool>
        SynchronizeIdentityUserAsync(
            ApplicationUser identityUser,
            MongoUserAccount mongoAccount)
    {
        var changed =
            false;


        var cleanedEmail =
            mongoAccount.Email.Trim();


        /*
         * MongoDB is authoritative for the profile fields.
         */


        if (!string.Equals(
                identityUser.Email,
                cleanedEmail,
                StringComparison.Ordinal))
        {
            identityUser.Email =
                cleanedEmail;

            changed =
                true;
        }


        if (!string.Equals(
                identityUser.UserName,
                cleanedEmail,
                StringComparison.Ordinal))
        {
            identityUser.UserName =
                cleanedEmail;

            changed =
                true;
        }


        if (!string.Equals(
                identityUser.FirstName,
                mongoAccount.FirstName,
                StringComparison.Ordinal))
        {
            identityUser.FirstName =
                mongoAccount.FirstName;

            changed =
                true;
        }


        if (!string.Equals(
                identityUser.Surname,
                mongoAccount.Surname,
                StringComparison.Ordinal))
        {
            identityUser.Surname =
                mongoAccount.Surname;

            changed =
                true;
        }


        /*
         * Keep the local password hash synchronised with
         * MongoDB too.
         */


        if (!string.Equals(
                identityUser.PasswordHash,
                mongoAccount.PasswordHash,
                StringComparison.Ordinal))
        {
            identityUser.PasswordHash =
                mongoAccount.PasswordHash;

            changed =
                true;
        }


        /*
         * Your Program.cs currently has
         * RequireConfirmedAccount = false, but setting this
         * makes mirrored Mongo accounts behave consistently
         * with locally registered users.
         */


        if (!identityUser.EmailConfirmed)
        {
            identityUser.EmailConfirmed =
                true;

            changed =
                true;
        }


        if (!changed)
        {
            return true;
        }


        var updateResult =
            await UserManager
                .UpdateAsync(
                    identityUser);


        if (updateResult.Succeeded)
        {
            Logger.LogInformation(
                "Synchronised local Identity account for {Email} from MongoDB.",
                mongoAccount.Email);


            return true;
        }


        var errors =
            string.Join(
                "; ",
                updateResult.Errors
                    .Select(
                        error =>
                            $"{error.Code}: {error.Description}"));


        Logger.LogError(
            "Unable to synchronise local Identity account for {Email}. {Errors}",
            mongoAccount.Email,
            errors);


        errorMessage =
            "Error: Your MongoDB login was valid, but the local Identity account could not be synchronised. " +
            errors;


        return false;
    }


    /*
     * =====================================================
     * PASSKEY LOGIN RESULT
     * =====================================================
     */


    private async Task
        HandleIdentitySignInResultAsync(
            SignInResult result)
    {
        if (result.Succeeded)
        {
            Logger.LogInformation(
                "User logged in using a passkey.");


            RedirectManager.RedirectTo(
                ReturnUrl);


            return;
        }


        if (result.RequiresTwoFactor)
        {
            RedirectManager.RedirectTo(
                "Account/LoginWith2fa",
                new Dictionary<string, object?>
                {
                    ["returnUrl"] =
                        ReturnUrl,

                    ["rememberMe"] =
                        Input.RememberMe
                });


            return;
        }


        if (result.IsLockedOut)
        {
            Logger.LogWarning(
                "User account locked out.");


            RedirectManager.RedirectTo(
                "Account/Lockout");


            return;
        }


        if (result.IsNotAllowed)
        {
            errorMessage =
                "Error: Please confirm your email address before signing in.";


            return;
        }


        errorMessage =
            "Error: The email address or password is incorrect.";


        await Task.CompletedTask;
    }


    private void TogglePasswordVisibility()
    {
        showPassword =
            !showPassword;
    }


    private sealed class InputModel
    {
        [Required(
            ErrorMessage =
                "Please enter your email address.")]

        [EmailAddress(
            ErrorMessage =
                "Please enter a valid email address.")]

        public string Email
        {
            get;
            set;
        } =
            string.Empty;


        [Required(
            ErrorMessage =
                "Please enter your password.")]

        [DataType(
            DataType.Password)]

        public string Password
        {
            get;
            set;
        } =
            string.Empty;


        [Display(
            Name = "Remember me")]

        public bool RememberMe
        {
            get;
            set;
        }


        public PasskeyInputModel? Passkey
        {
            get;
            set;
        }
    }
}