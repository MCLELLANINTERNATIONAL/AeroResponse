@inherits LayoutComponentBase

<div class="auth-page">
    <section class="auth-visual-panel">
        <div class="auth-visual-shade"></div>

        <div class="auth-visual-content">
            <a
                class="auth-brand"
                href="/"
                aria-label="Go to AeroResponse home page">

                <img
                    src="/images/logo1.png"
                    alt="AeroResponse"
                    class="auth-brand-logo" />
            </a>

            <div class="auth-visual-message">
                <h1>
                    Prepare for Every
                    <span>Critical Moment</span>
                </h1>

                <p>
                    AeroResponse helps aviation professionals
                    train, simulate, and respond with confidence.
                </p>
            </div>

            <div class="auth-feature-grid">
                <article class="auth-feature">
                    <div class="auth-feature-icon">
                        <svg
                            viewBox="0 0 24 24"
                            role="img"
                            aria-label="Shield icon">

                            <path
                                d="M12 3 4.5 6v5.3c0 4.8 3.2 8.9 7.5 10.2 4.3-1.3 7.5-5.4 7.5-10.2V6L12 3Z" />

                            <path
                                d="m8.6 12.1 2.1 2.1 4.7-4.8" />
                        </svg>
                    </div>

                    <h2>Realistic Scenarios</h2>

                    <p>
                        Industry-grade emergency training
                        simulations.
                    </p>
                </article>

                <article class="auth-feature">
                    <div class="auth-feature-icon">
                        <svg
                            viewBox="0 0 24 24"
                            role="img"
                            aria-label="Performance graph icon">

                            <path d="M4 19V5" />
                            <path d="M4 19h16" />
                            <path d="m7 15 4-4 3 2 5-6" />
                        </svg>
                    </div>

                    <h2>Track Performance</h2>

                    <p>
                        Monitor progress and improve
                        continuously.
                    </p>
                </article>

                <article class="auth-feature">
                    <div class="auth-feature-icon">
                        <svg
                            viewBox="0 0 24 24"
                            role="img"
                            aria-label="Award badge icon">

                            <circle
                                cx="12"
                                cy="9"
                                r="6" />

                            <path
                                d="m9.5 14.4-1 6 3.5-2 3.5 2-1-6" />

                            <path
                                d="m12 5.7.8 1.6 1.8.3-1.3 1.3.3 1.8-1.6-.8-1.6.8.3-1.8-1.3-1.3 1.8-.3.8-1.6Z" />
                        </svg>
                    </div>

                    <h2>Earn Badges</h2>

                    <p>
                        Showcase your skills and
                        achievements.
                    </p>
                </article>
            </div>
        </div>
    </section>

    <main class="auth-content-panel">
        <div class="auth-mobile-header">
            <a
                href="/"
                aria-label="Go to AeroResponse home page">

                <img
                    src="/images/logo1.png"
                    alt="AeroResponse" />
            </a>
        </div>

        <div class="auth-content-scroll">
            <div class="auth-content-container">
                @Body
            </div>
        </div>
    </main>
</div>