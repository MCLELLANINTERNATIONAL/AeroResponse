@using AeroResponse.Simulation

<div class="fuel-gauges">
    @if (FuelTanks is not null && FuelTanks.Count > 0)
    {
        @foreach (var tank in FuelTanks)
        {
            var fill = MaxFuel > 0 ? Math.Clamp(tank.Quantity / MaxFuel, 0, 1) : 0;

            <div class="fuel-gauge">
                <div class="fuel-label">Tank @tank.Number</div>
                <div class="fuel-bar">
                    <div class="fuel-fill" style="height:@($"{fill * 100:F0}%")"></div>
                </div>
                <div class="fuel-value">@tank.Quantity:N1 gal</div>
            </div>
        }
    }
    else
    {
        <div class="fuel-empty">No fuel tanks configured</div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<FuelState> FuelTanks { get; set; } = [];
    [Parameter] public double MaxFuel { get; set; } = 26.5;
}