@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using AeroResponse.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

@if (externalLogins.Length > 0)
{
    <form
        class="external-login-form"
        action="/Account/PerformExternalLogin"
        method="post">

        <AntiforgeryToken />

        <input
            type="hidden"
            name="ReturnUrl"
            value="@ReturnUrl" />

        <div class="external-login-list">
            @foreach (var provider in externalLogins)
            {
                <button
                    type="submit"
                    class="external-login-button"
                    name="provider"
                    value="@provider.Name"
                    title="Continue using your @provider.DisplayName account">

                    @if (IsGoogle(provider))
                    {
                        <svg
                            class="provider-icon google-icon"
                            viewBox="0 0 24 24"
                            aria-hidden="true">
                            <path
                                fill="#4285F4"
                                d="M21.6 12.2c0-.7-.1-1.4-.2-2.1H12v4h5.4a4.6 4.6 0 0 1-2 3v2.6h3.3c1.9-1.8 2.9-4.4 2.9-7.5Z" />
                            <path
                                fill="#34A853"
                                d="M12 22c2.7 0 5-.9 6.7-2.3l-3.3-2.6c-.9.6-2.1 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3v2.7A10 10 0 0 0 12 22Z" />
                            <path
                                fill="#FBBC05"
                                d="M6.4 14a6 6 0 0 1 0-4V7.3H3a10 10 0 0 0 0 9.4L6.4 14Z" />
                            <path
                                fill="#EA4335"
                                d="M12 5.9c1.5 0 2.8.5 3.9 1.5l2.9-2.9A9.8 9.8 0 0 0 3 7.3L6.4 10c.8-2.4 3-4.1 5.6-4.1Z" />
                        </svg>
                    }
                    else if (IsMicrosoft(provider))
                    {
                        <svg
                            class="provider-icon"
                            viewBox="0 0 24 24"
                            aria-hidden="true">
                            <path fill="#F25022" d="M2 2h9v9H2z" />
                            <path fill="#7FBA00" d="M13 2h9v9h-9z" />
                            <path fill="#00A4EF" d="M2 13h9v9H2z" />
                            <path fill="#FFB900" d="M13 13h9v9h-9z" />
                        </svg>
                    }
                    else
                    {
                        <svg
                            class="provider-icon generic-provider-icon"
                            viewBox="0 0 24 24"
                            aria-hidden="true">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M3 12h18" />
                            <path d="M12 3a15 15 0 0 1 0 18" />
                            <path d="M12 3a15 15 0 0 0 0 18" />
                        </svg>
                    }

                    <span>
                        Continue with @provider.DisplayName
                    </span>
                </button>
            }
        </div>
    </form>
}

@code {
    private AuthenticationScheme[] externalLogins = [];

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        externalLogins =
            (await SignInManager
                .GetExternalAuthenticationSchemesAsync())
            .ToArray();
    }

    private static bool IsGoogle(
        AuthenticationScheme provider)
    {
        return provider.Name.Contains(
                "Google",
                StringComparison.OrdinalIgnoreCase)
            || provider.DisplayName?.Contains(
                "Google",
                StringComparison.OrdinalIgnoreCase)
                == true;
    }

    private static bool IsMicrosoft(
        AuthenticationScheme provider)
    {
        return provider.Name.Contains(
                "Microsoft",
                StringComparison.OrdinalIgnoreCase)
            || provider.DisplayName?.Contains(
                "Microsoft",
                StringComparison.OrdinalIgnoreCase)
                == true;
    }
}