@page "/reports/scoring"
@attribute [Authorize(Policy = AccountPermissions.PilotPages)]
@rendermode InteractiveServer
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject PerformanceDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Scoring | AeroResponse</PageTitle>

@if (_loading)
{
    <div class="reports-loading">
        Loading scoring information…
    </div>
}
else if (_dashboard?.Latest is null)
{
    <div class="reports-empty">
        <h1>No scoring information yet</h1>
        <p>
            Complete a practice scenario to view your scoring results.
        </p>
    </div>
}
else
{
    var report = _dashboard.Latest;

    <main class="reports-page">

        <header class="reports-header">
            <div>
                <h1>SCORING</h1>
                <p>
                    Review your overall score and performance breakdown
                </p>
            </div>

            <div class="pilot-chip">
                <span class="pilot-avatar">
                    ✈
                </span>

                <div>
                    <strong>
                        @report.PilotName
                    </strong>

                    <small>
                        Professional Pilot
                    </small>
                </div>
            </div>
        </header>

        <nav class="reports-tabs">

            <NavLink
                href="/reports"
                Match="NavLinkMatch.All">
                ◉ Overview
            </NavLink>

            <NavLink href="/reports/flight-logs">
                ✈ Flight Logs
            </NavLink>

            <NavLink href="/reports/scoring">
                ⚙ Scoring
            </NavLink>

            <NavLink href="/reports/analytics">
                ▥ Analytics
            </NavLink>

            <NavLink href="/reports/feedback">
                ✪ Feedback
            </NavLink>

            <NavLink href="/reports/badges">
                🏆 Badges
            </NavLink>

            <NavLink href="/reports/instructor">
                👨‍✈ Instructor Reports
            </NavLink>

            <NavLink href="/reports/admin">
                ▦ Admin Reports
            </NavLink>

        </nav>

        <section class="reports-grid top-grid">

            <!-- =========================================================
                 OVERALL SCORE
                 ========================================================= -->

            <article class="report-card score-card">

                <h2>
                    Overall Score
                </h2>

                <div class="score-main">

                    <div
                        class="score-ring"
                        style="--score:@report.OverallScore">

                        <span>
                            @report.OverallScore%
                        </span>

                        <small>
                            @(report.Passed
                                ? "Great Performance!"
                                : "Keep Practising")
                        </small>

                    </div>

                    <div class="score-copy">

                        <small>
                            Total Score
                        </small>

                        <strong>
                            @(report.OverallScore * 10) / 1000
                        </strong>

                        <small>
                            Passing Score
                        </small>

                        <b>
                            70% (700/1000)
                        </b>

                        <small>
                            Rank
                        </small>

                        <strong>
                            Top @RankPercent%
                        </strong>

                        <em>
                            of all users
                        </em>

                    </div>

                </div>

                <div class="pass-banner">

                    🏆

                    <span>

                        <strong>
                            @(report.Passed
                                ? "You passed this scenario!"
                                : "Scenario not yet passed")
                        </strong>

                        <small>
                            @(report.Passed
                                ? "Keep up the great work."
                                : "Review feedback and try again.")
                        </small>

                    </span>

                </div>

            </article>


            <!-- =========================================================
                 SCORE BREAKDOWN
                 ========================================================= -->

            <article class="report-card">

                <h2>
                    Score Breakdown
                </h2>


                <!-- PROCEDURAL ACCURACY -->

                <div class="metric">

                    <div class="metric-result">

                        <span>
                            Procedural Accuracy
                        </span>

                        <strong>
                            @report.ProcedureAccuracyScore%
                        </strong>

                    </div>

                    <div class="metric-track">

                        <div
                            class="metric-fill blue"
                            style="width: @report.ProcedureAccuracyScore%;">
                        </div>

                    </div>

                </div>


                <!-- DECISION MAKING -->

                <div class="metric">

                    <div class="metric-result">

                        <span>
                            Decision Making
                        </span>

                        <strong>
                            @report.DecisionMakingScore%
                        </strong>

                    </div>

                    <div class="metric-track">

                        <div
                            class="metric-fill green"
                            style="width: @report.DecisionMakingScore%;">
                        </div>

                    </div>

                </div>


                <!-- CHECKLIST USAGE -->

                <div class="metric">

                    <div class="metric-result">

                        <span>
                            Checklist Usage
                        </span>

                        <strong>
                            @report.ChecklistUsageScore%
                        </strong>

                    </div>

                    <div class="metric-track">

                        <div
                            class="metric-fill orange"
                            style="width: @report.ChecklistUsageScore%;">
                        </div>

                    </div>

                </div>


                <!-- TIME MANAGEMENT -->

                <div class="metric">

                    <div class="metric-result">

                        <span>
                            Time Management
                        </span>

                        <strong>
                            @report.TimeManagementScore%
                        </strong>

                    </div>

                    <div class="metric-track">

                        <div
                            class="metric-fill purple"
                            style="width: @report.TimeManagementScore%;">
                        </div>

                    </div>

                </div>


                <!-- COMMUNICATION -->

                <div class="metric">

                    <div class="metric-result">

                        <span>
                            Communication
                        </span>

                        <strong>
                            @report.CommunicationScore%
                        </strong>

                    </div>

                    <div class="metric-track">

                        <div
                            class="metric-fill cyan"
                            style="width: @report.CommunicationScore%;">
                        </div>

                    </div>

                </div>

            </article>


            <!-- =========================================================
                 CURRENT SCENARIO
                 ========================================================= -->

            <article class="report-card scenario-summary">

                <h2>
                    Current Scenario
                </h2>

                <div class="scenario-title">

                    <span>
                        ✈
                    </span>

                    <div>

                        <strong>
                            @report.ScenarioName
                        </strong>

                        <small>
                            Completed:
                            @(report.CompletedAt
                                .ToLocalTime()
                                .ToString(
                                    "dd MMM yyyy 'at' HH:mm"))
                        </small>

                        <small>
                            Difficulty:
                            @report.Difficulty
                        </small>

                    </div>

                    <b>
                        EMERGENCY
                    </b>

                </div>

                <hr />


                <!-- REACTION TIME -->

                <div class="info-row">

                    <span>
                        ◷
                    </span>

                    <label>
                        Reaction Time
                    </label>

                    <strong>
                        @report.ReactionTimeSeconds seconds
                    </strong>

                </div>


                <!-- ACTIONS TAKEN -->

                <div class="info-row">

                    <span>
                        ☑
                    </span>

                    <label>
                        Actions Taken
                    </label>

                    <strong>
                        @report.ActionsTaken
                    </strong>

                </div>


                <!-- CHECKLIST USED -->

                <div class="info-row">

                    <span>
                        ▣
                    </span>

                    <label>
                        Checklist Used
                    </label>

                    <strong>
                        @report.ChecklistUsageScore%
                    </strong>

                </div>

            </article>

        </section>

        <p class="live-note">
            ● Live scoring information updates automatically when a pilot
            completes a practice scenario.
        </p>

    </main>
}


@code {

    /*
     * =====================================================================
     * CURRENT PILOT
     *
     * Authentication is not yet fully implemented.
     *
     * If an authenticated Identity user exists, use their real UserId.
     *
     * Otherwise use debug-pilot during development so Simulation,
     * Overview, Flight Logs, Scoring, Analytics, Feedback and Badges
     * can all reference the same pilot.
     * =====================================================================
     */

    private string _currentUserId =
        string.Empty;


    /*
     * =====================================================================
     * PAGE STATE
     * =====================================================================
     */

    private PerformanceDashboardVm? _dashboard;

    private bool _loading = true;


    /*
     * =====================================================================
     * INITIALIZATION
     * =====================================================================
     */

    protected override async Task OnInitializedAsync()
    {
        /*
         * Obtain the current authentication state.
         */
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var principal =
            authenticationState.User;


        /*
         * Use the authenticated ASP.NET Identity UserId where available.
         *
         * Until authentication is complete, all unauthenticated
         * development simulations use debug-pilot.
         */
        _currentUserId =
            principal.FindFirstValue(
                ClaimTypes.NameIdentifier)
            ?? "debug-pilot";


        /*
         * Listen for newly completed simulation reports.
         */
        PerformanceFeed.ReportSaved +=
            OnReportSaved;


        /*
         * Load the current pilot's scoring data.
         */
        await LoadAsync();
    }


    /*
     * =====================================================================
     * LIVE REPORT UPDATE
     * =====================================================================
     */

    private async void OnReportSaved(
        string userId)
    {
        /*
         * Ignore reports belonging to another pilot.
         */
        if (!string.Equals(
                userId,
                _currentUserId,
                StringComparison.Ordinal))
        {
            return;
        }


        /*
         * Reload this pilot's report immediately after a simulation
         * has been saved.
         */
        await InvokeAsync(
            async () =>
            {
                await LoadAsync();

                StateHasChanged();
            });
    }


    /*
     * =====================================================================
     * LOAD DASHBOARD DATA
     * =====================================================================
     */

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;

            /*
             * IMPORTANT:
             *
             * The scoring page now requests exactly the same pilot ID
             * that the simulation uses when saving the report.
             */
            _dashboard =
                await DashboardService
                    .GetDashboardAsync(
                        _currentUserId);
        }
        finally
        {
            _loading = false;
        }
    }


    /*
     * =====================================================================
     * RANK DISPLAY
     * =====================================================================
     */

    private int RankPercent =>
        Math.Max(
            1,
            100 -
            (_dashboard?.Latest?.OverallScore ?? 0));


    /*
     * =====================================================================
     * CLEANUP
     * =====================================================================
     */

    public void Dispose()
    {
        PerformanceFeed.ReportSaved -=
            OnReportSaved;
    }
}