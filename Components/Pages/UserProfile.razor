    private async Task ConfirmMemberRemovalAsync()
    {
        if (isRemovingCompanyMember ||
            string.IsNullOrWhiteSpace(
                memberBeingRemovedId))
        {
            return;
        }

        isRemovingCompanyMember = true;
        successMessage = null;
        actionErrorMessage = null;

        var removedMemberName =
            memberBeingRemovedName;

        try
        {
            var removed =
                await MongoUserAccounts
                    .DisconnectCompanyMemberAsync(
                        identityUserId,
                        memberBeingRemovedId);

            if (!removed)
            {
                actionErrorMessage =
                    "That account is no longer connected " +
                    "to this company.";

                return;
            }

            companyMembers =
                await MongoUserAccounts
                    .FindLinkedMembersAsync(
                        identityUserId);

            successMessage =
                $"{removedMemberName} has been removed " +
                "from the company.";

            CancelMemberRemoval();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Could not remove company member {MemberId} " +
                "from owner {OwnerId}.",
                memberBeingRemovedId,
                identityUserId);

            actionErrorMessage =
                "The company member could not be removed. " +
                "Please try again.";
        }
        finally
        {
            isRemovingCompanyMember = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

    private static string BuildIdentityErrorMessage(
        IdentityResult result)
    {
        var errors =
            result.Errors
                .Select(
                    error =>
                        error.Description)
                .Where(
                    description =>
                        !string.IsNullOrWhiteSpace(
                            description));

        var message =
            string.Join(
                " ",
                errors);

        return string.IsNullOrWhiteSpace(message)
            ? "Your account details could not be updated."
            : message;
    }

    private static string FormatDate(
        DateTime utcDate)
    {
        return utcDate
            .ToLocalTime()
            .ToString(
                "d MMMM yyyy");
    }

    private static string FormatDateAndTime(
        DateTime utcDate)
    {
        return utcDate
            .ToLocalTime()
            .ToString(
                "d MMMM yyyy 'at' HH:mm");
    }

    private static string FormatCardBrand(
        string? cardBrand)
    {
        return string.IsNullOrWhiteSpace(cardBrand)
            ? "Card"
            : FormatValue(cardBrand);
    }

    private static string FormatCardExpiry(
        string? expiry)
    {
        if (string.IsNullOrWhiteSpace(expiry))
        {
            return "Not available";
        }

        var cleaned =
            expiry.Trim();

        var parts =
            cleaned.Split(
                '/',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries);

        if (parts.Length == 2 &&
            int.TryParse(
                parts[0],
                out var month) &&
            int.TryParse(
                parts[1],
                out var year))
        {
            if (year < 100)
            {
                year += 2000;
            }

            if (month is >= 1 and <= 12)
            {
                return new DateTime(
                        year,
                        month,
                        1)
                    .ToString(
                        "MMMM yyyy");
            }
        }

        return cleaned;
    }

    private static string NormaliseAccountType(
        string? value)
    {
        return value?
            .Trim()
            .ToLowerInvariant() switch
        {
            "pilot" =>
                "pilot",

            "trainer" =>
                "trainer",

            "owner_small" =>
                "owner_small",

            "owner_large" =>
                "owner_large",

            _ =>
                MongoUserAccount.DefaultAccountType
        };
    }

    private static string BuildDisplayName(
        string? firstName,
        string? surname)
    {
        return string.Join(
            " ",
            new[]
            {
                firstName?.Trim(),
                surname?.Trim()
            }
            .Where(
                value =>
                    !string.IsNullOrWhiteSpace(
                        value)));
    }

    private static string GetFallbackName(
        ClaimsPrincipal user)
    {
        var identityName =
            user.Identity?.Name;

        if (string.IsNullOrWhiteSpace(identityName))
        {
            return "Account";
        }

        return GetNameFromEmail(
            identityName);
    }

    private static string GetNameFromEmail(
        string value)
    {
        var atIndex =
            value.IndexOf(
                '@',
                StringComparison.Ordinal);

        return atIndex > 0
            ? value[..atIndex]
            : value;
    }

    private static string BuildInitials(
        string name)
    {
        var parts =
            name.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries |
                StringSplitOptions.TrimEntries);

        return parts.Length switch
        {
            0 =>
                "A",

            1 =>
                parts[0][0]
                    .ToString()
                    .ToUpperInvariant(),

            _ =>
                string.Concat(
                        parts[0][0],
                        parts[^1][0])
                    .ToUpperInvariant()
        };
    }

    private static string FormatValue(
        string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Not available";
        }

        var cleaned =
            value
                .Trim()
                .Replace(
                    "_",
                    " ")
                .Replace(
                    "-",
                    " ");

        return string.Join(
            " ",
            cleaned
                .Split(
                    ' ',
                    StringSplitOptions.RemoveEmptyEntries)
                .Select(
                    word =>
                        char.ToUpperInvariant(
                            word[0])
                        + word[1..]
                            .ToLowerInvariant()));
    }

