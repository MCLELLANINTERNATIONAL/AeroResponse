    {
        return
            $"grid-template-columns: repeat(" +
            $"{layoutEditor.Columns}, minmax(0, 1fr));" +
            $"grid-template-rows: repeat(" +
            $"{layoutEditor.Rows}, minmax(80px, 1fr));";
    }

