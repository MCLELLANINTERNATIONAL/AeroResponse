@page "/user"
@rendermode InteractiveServer
@attribute [Authorize]

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using AeroResponse.Data
@using AeroResponse.Data.Mongo.Accounts
@using AeroResponse.Data.Mongo.Memberships
@using AeroResponse.Data.Mongo.Payments
@using AeroResponse.Data.Mongo.Referrals
@using AeroResponse.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using MongoDB.Driver

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MongoUserAccountRepository MongoUserAccounts
@inject MongoMemberTimelineRepository MemberTimelines
@inject MongoSavedPaymentMethodRepository SavedPaymentMethods
@inject OwnerReferralCodeService ReferralCodeService
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<UserProfile> Logger

<PageTitle>User Profile</PageTitle>

<section class="profile-page">
    <div class="profile-container">

        @if (isLoading)
        {
            <div class="profile-state"
                 role="status">

                Loading your account...
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="profile-state profile-state-error"
                 role="alert">

                @errorMessage
            </div>
        }
        else
        {
            <header class="profile-hero">
                <div class="profile-avatar"
                     aria-hidden="true">

                    @initials
                </div>

                <div>
                    <p class="profile-eyebrow">
                        AeroResponse account
                    </p>

                    <h1>@displayName</h1>

                    <p class="profile-email">
                        @email
                    </p>
                </div>

                <div class="profile-hero-actions">
                    <span class="account-type-badge">
                        @AccountTypeLabel
                    </span>

                    <button type="button"
                            class="delete-account-button"
                            @onclick="RequestAccountDeletion">
                        Delete account
                    </button>
                </div>
            </header>

            @if (confirmAccountDeletion)
            {
                <div class="account-delete-overlay"
                     role="presentation">
                    <div class="account-delete-modal"
                         role="dialog"
                         aria-modal="true"
                         aria-labelledby="delete-account-title">
                        <p class="card-kicker">Permanent action</p>

                        <h2 id="delete-account-title">
                            Delete your account?
                        </h2>

                        <p>
                            Are you sure? This permanently deletes your
                            AeroResponse account and cannot be undone.
                        </p>

                        <div class="profile-actions">
                            <form method="post" action="/Account/Delete">
                                <AntiforgeryToken />

                                <button type="submit"
                                        class="danger-action">
                                    Yes, delete my account
                                </button>
                            </form>

                            <button type="button"
                                    class="secondary-action"
                                    @onclick="CancelAccountDeletion">
                                Cancel
                            </button>
                        </div>
                    </div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(successMessage))
            {
                <div class="profile-message profile-message-success"
                     role="status">

                    @successMessage
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(actionErrorMessage))
            {
                <div class="profile-message profile-message-error"
                     role="alert">

                    @actionErrorMessage
                </div>
            }

            <div class="profile-grid">

                <article class="profile-card account-details-card">
                    <div class="card-heading-row">
                        <h2>Account details</h2>

                        @if (!isEditing)
                        {
                            <button type="button"
                                    class="secondary-action edit-button"
                                    disabled="@(isSaving || isLoading)"
                                    @onclick="BeginEditingAsync">

                                Edit details
                            </button>
                        }
                    </div>

                    @if (isEditing)
                    {
                        <EditForm Model="editModel"
                                  OnValidSubmit="SaveAccountDetailsAsync">

                            <DataAnnotationsValidator />

                            <ValidationSummary class="validation-summary" />

                            <div class="profile-form-grid">

                                <div class="form-field">
                                    <label for="first-name">
                                        First name
                                    </label>

                                    <InputText id="first-name"
                                               class="profile-input"
                                               @bind-Value="editModel.FirstName" />

                                    <ValidationMessage
                                        For="() => editModel.FirstName"
                                        class="field-error" />
                                </div>

                                <div class="form-field">
                                    <label for="surname">
                                        Surname
                                    </label>

                                    <InputText id="surname"
                                               class="profile-input"
                                               @bind-Value="editModel.Surname" />

                                    <ValidationMessage
                                        For="() => editModel.Surname"
                                        class="field-error" />
                                </div>

                                <div class="form-field form-field-full">
                                    <label for="email">
                                        Email
                                    </label>

                                    <InputText id="email"
                                               type="email"
                                               class="profile-input"
                                               @bind-Value="editModel.Email" />

                                    <ValidationMessage
                                        For="() => editModel.Email"
                                        class="field-error" />
                                </div>

                            </div>

                            <div class="profile-actions">
                                <button type="submit"
                                        class="primary-action"
                                        disabled="@isSaving">

                                    @(isSaving
                                        ? "Saving..."
                                        : "Save changes")
                                </button>

                                <button type="button"
                                        class="secondary-action"
                                        disabled="@isSaving"
                                        @onclick="CancelEditingAsync">

                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <dl class="details-list">
                            <div>
                                <dt>Name</dt>
                                <dd>@displayName</dd>
                            </div>

                            <div>
                                <dt>Email</dt>
                                <dd>@email</dd>
                            </div>

                            <div>
                                <dt>Account type</dt>
                                <dd>@AccountTypeLabel</dd>
                            </div>

                            @if (IsOwnerAccount &&
                                 !string.IsNullOrWhiteSpace(businessName))
                            {
                                <div>
                                    <dt>Business name</dt>
                                    <dd>@businessName</dd>
                                </div>
                            }

                            <div>
                                <dt>Member since</dt>
                                <dd>@MemberSinceLabel</dd>
                            </div>
                        </dl>
                    }
                </article>

                @if (accountType == "pilot")
                {
                    <article class="profile-card profile-card-featured">
                        <p class="card-kicker">
                            Pilot account
                        </p>

                        <h2>Your training account</h2>

                        @if (UsesCompanyMembership)
                        {
                            <p>
                                Your pilot account is connected to
                                <strong>@ConnectedCompanyName</strong>.
                            </p>
                        }
                        else
                        {
                            <p>
                                Access personal simulation training,
                                performance reports, scoring, badges
                                and flight history.
                            </p>
                        }

                        <div class="profile-actions">
                            <a class="primary-action"
                               href="/simulation">

                                Start simulation
                            </a>

                            <a class="secondary-action"
                               href="/reports">

                                View reports
                            </a>
                        </div>
                    </article>
                }
                else if (accountType == "trainer")
                {
                    <article class="profile-card profile-card-featured">
                        <p class="card-kicker">
                            Trainer account
                        </p>

                        <h2>Your trainer account</h2>

                        @if (UsesCompanyMembership)
                        {
                            <p>
                                Your trainer account is connected to
                                <strong>@ConnectedCompanyName</strong>.
                            </p>
                        }
                        else
                        {
                            <p>
                                Access training tools, pilot performance
                                information and simulation features.
                            </p>
                        }
                    </article>
                }
                else if (accountType == "guest")
                {
                    <article class="profile-card profile-card-featured">
                        <p class="card-kicker">
                            Guest account
                        </p>

                        <h2>Choose a membership</h2>

                        <p>
                            Your account is active, but it does not
                            currently have a paid membership. Select
                            a plan to unlock training features.
                        </p>

                        <div class="profile-actions">
                            <a class="primary-action"
                               href="/membership">

                                View memberships
                            </a>
                        </div>
                    </article>
                }

                <article class="profile-card membership-card">
                    <h2>Membership</h2>

                    @if (UsesCompanyMembership)
                    {
                        <p class="company-membership-note">
                            This membership is provided by
                            <strong>@ConnectedCompanyName</strong>.
                        </p>
                    }

                    @if (membership is null)
                    {
                        <p>
                            No active membership details were found.
                        </p>
                    }
                    else
                    {
                        <dl class="details-list">
                            <div>
                                <dt>Plan</dt>
                                <dd>@membership.PlanName</dd>
                            </div>

                            <div>
                                <dt>Billing</dt>

                                <dd>
                                    @FormatValue(
                                        membership.BillingFrequency)
                                </dd>
                            </div>

                            <div>
                                <dt>Started</dt>

                                <dd>
                                    @FormatDate(
                                        membership
                                            .MembershipStartedAtUtc)
                                </dd>
                            </div>

                            <div>
                                <dt>
                                    @(membershipPaymentMethod is not null
                                        ? "Renews"
                                        : "Expires")
                                </dt>

                                <dd>
                                    @FormatDate(
                                        membership
                                            .MembershipExpiresAtUtc)
                                </dd>
                            </div>
                        </dl>
                    }
                </article>

                <article class="profile-card payment-card">
                    <div class="card-heading-row">
                        <div>
                            <p class="card-kicker">
                                Payment method
                            </p>

                            <h2>
                                @(savedPaymentMethod is null
                                    ? "Add a card"
                                    : "Saved card")
                            </h2>
                        </div>

                        @if (!isEditingCard)
                        {
                            <button type="button"
                                    class="secondary-action"
                                    disabled="@isSavingCard"
                                    @onclick="BeginCardEditingAsync">
                                @(savedPaymentMethod is null
                                    ? "Add card"
                                    : "Change card")
                            </button>
                        }
                    </div>

                    @if (isEditingCard)
                    {
                        <EditForm Model="cardEditModel"
                                  OnValidSubmit="SaveCardAsync">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="validation-summary" />

                            <div class="profile-form-grid card-form-grid">
                                <div class="form-field form-field-full">
                                    <label for="card-number">Card number</label>
                                    <InputText id="card-number"
                                               class="profile-input"
                                               inputmode="numeric"
                                               autocomplete="cc-number"
                                               placeholder="4242 4242 4242 4242"
                                               @bind-Value="cardEditModel.CardNumber" />
                                    <ValidationMessage For="() => cardEditModel.CardNumber"
                                                       class="field-error" />
                                </div>

                                <div class="form-field">
                                    <label for="card-expiry">Expiry date</label>
                                    <InputText id="card-expiry"
                                               class="profile-input"
                                               autocomplete="cc-exp"
                                               placeholder="MM / YY"
                                               @bind-Value="cardEditModel.ExpiryDate" />
                                    <ValidationMessage For="() => cardEditModel.ExpiryDate"
                                                       class="field-error" />
                                </div>

                                <div class="form-field">
                                    <label for="cardholder-name">Cardholder name</label>
                                    <InputText id="cardholder-name"
                                               class="profile-input"
                                               autocomplete="cc-name"
                                               @bind-Value="cardEditModel.CardholderName" />
                                    <ValidationMessage For="() => cardEditModel.CardholderName"
                                                       class="field-error" />
                                </div>

                                <div class="form-field">
                                    <label for="billing-country">Country</label>
                                    <InputText id="billing-country"
                                               class="profile-input"
                                               autocomplete="country-name"
                                               @bind-Value="cardEditModel.Country" />
                                </div>

                                <div class="form-field">
                                    <label for="billing-postcode">Postcode / ZIP</label>
                                    <InputText id="billing-postcode"
                                               class="profile-input"
                                               autocomplete="postal-code"
                                               @bind-Value="cardEditModel.PostalCode" />
                                </div>

                                <div class="form-field form-field-full">
                                    <label for="billing-address">Billing address</label>
                                    <InputText id="billing-address"
                                               class="profile-input"
                                               autocomplete="address-line1"
                                               @bind-Value="cardEditModel.AddressLineOne" />
                                </div>

                                <div class="form-field">
                                    <label for="billing-city">City</label>
                                    <InputText id="billing-city"
                                               class="profile-input"
                                               autocomplete="address-level2"
                                               @bind-Value="cardEditModel.City" />
                                </div>

                                <div class="form-field">
                                    <label for="billing-region">County / State / Region</label>
                                    <InputText id="billing-region"
                                               class="profile-input"
                                               autocomplete="address-level1"
                                               @bind-Value="cardEditModel.Region" />
                                </div>
                            </div>

                            <p class="payment-security-note">
                                Only a payment token and the last four digits are saved.
                                The full card number is not stored.
                            </p>

                            <div class="profile-actions">
                                <button type="submit"
                                        class="primary-action"
                                        disabled="@isSavingCard">
                                    @(isSavingCard ? "Saving..." : "Save card")
                                </button>

                                <button type="button"
                                        class="secondary-action"
                                        disabled="@isSavingCard"
                                        @onclick="CancelCardEditingAsync">
                                    Cancel
                                </button>
                            </div>
                        </EditForm>
                    }
                    else if (savedPaymentMethod is not null)
                    {
                        <dl class="details-list">
                            <div>
                                <dt>Card</dt>
                                <dd>
                                    @FormatCardBrand(savedPaymentMethod.CardBrand)
                                    ending in @savedPaymentMethod.LastFour
                                </dd>
                            </div>

                            <div>
                                <dt>Cardholder</dt>
                                <dd>@savedPaymentMethod.CardholderName</dd>
                            </div>

                            <div>
                                <dt>Card expiry</dt>
                                <dd>@FormatCardExpiry(savedPaymentMethod.ExpiryDate)</dd>
                            </div>
                        </dl>

                        @if (confirmCardDeletion)
                        {
                            <div class="delete-confirmation">
                                <p>Are you sure you want to delete your saved card?</p>

                                <div class="profile-actions">
                                    <button type="button"
                                            class="danger-action"
                                            disabled="@isDeletingCard"
                                            @onclick="DeleteSavedCardAsync">
                                        @(isDeletingCard ? "Deleting..." : "Yes, delete card")
                                    </button>

                                    <button type="button"
                                            class="secondary-action"
                                            disabled="@isDeletingCard"
                                            @onclick="CancelCardDeletionAsync">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="profile-actions">
                                <button type="button"
                                        class="danger-action"
                                        disabled="@isDeletingCard"
                                        @onclick="RequestCardDeletionAsync">
                                    Delete saved card
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p>
                            You do not currently have a saved card. Add one here
                            so it is available for future payments.
                        </p>
                    }
                </article>

                @if (IsOwnerAccount &&
                     ownerReferralCodes is not null)
                {
                    <article class="profile-card referral-card">
                        <p class="card-kicker">
                            Company invitations
                        </p>

                        <h2>Pilot and trainer links</h2>

                        <p>
                            Share the appropriate code with members
                            of your organisation. Each code is unique
                            to your company and changes every 24 hours.
                        </p>

                        <div class="referral-code-list">

                            <section class="referral-code">
                                <div class="referral-code-details">
                                    <span class="referral-label">
                                        Pilot code
                                    </span>

                                    <strong>
                                        @ownerReferralCodes.PilotCode
                                    </strong>
                                </div>

                                <span class="secondary-action referral-display-button">
                                    Pilot registration link
                                </span>
                            </section>

                            <section class="referral-code">
                                <div class="referral-code-details">
                                    <span class="referral-label">
                                        Trainer code
                                    </span>

                                    <strong>
                                        @ownerReferralCodes.TrainerCode
                                    </strong>
                                </div>

                                <span class="secondary-action referral-display-button">
                                    Trainer registration link
                                </span>
                            </section>

                        </div>

                        <p class="referral-expiry">
                            These codes expire on
                            @FormatDateAndTime(
                                ownerReferralCodes.ExpiresAtUtc).
                        </p>
                    </article>
                }

                @if (IsOwnerAccount)
                {
                    <article class="profile-card company-members-card">
                        <div class="company-members-heading">
                            <div>
                                <p class="card-kicker">
                                    Company members
                                </p>

                                <h2>Pilots and trainers</h2>
                            </div>

                            <div class="company-member-totals">
                                <span>
                                    @CompanyPilots.Count / @PilotLimit pilots
                                </span>

                                <span>
                                    @CompanyTrainers.Count / @TrainerLimit trainers
                                </span>
                            </div>
                        </div>

                        <div class="company-member-groups">
                            <section class="company-member-group">
                                <h3>
                                    Pilots

                                    <span>
                                        @CompanyPilots.Count / @PilotLimit
                                    </span>
                                </h3>

                                @if (CompanyPilots.Count == 0)
                                {
                                    <p class="empty-member-message">
                                        No pilots are currently connected.
                                    </p>
                                }
                                else
                                {
                                    <div class="company-member-list">
                                        @foreach (var member in CompanyPilots)
                                        {
                                            <div class="company-member-row">
                                                <div>
                                                    <strong>
                                                        @member.DisplayName
                                                    </strong>

                                                    <span>
                                                        @member.Email
                                                    </span>
                                                </div>

                                                <button type="button"
                                                        class="danger-action"
                                                        disabled="@isRemovingCompanyMember"
                                                        @onclick="() => RequestMemberRemoval(member)">
                                                    Remove
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </section>

                            <section class="company-member-group">
                                <h3>
                                    Trainers

                                    <span>
                                        @CompanyTrainers.Count / @TrainerLimit
                                    </span>
                                </h3>

                                @if (CompanyTrainers.Count == 0)
                                {
                                    <p class="empty-member-message">
                                        No trainers are currently connected.
                                    </p>
                                }
                                else
                                {
                                    <div class="company-member-list">
                                        @foreach (var member in CompanyTrainers)
                                        {
                                            <div class="company-member-row">
                                                <div>
                                                    <strong>
                                                        @member.DisplayName
                                                    </strong>

                                                    <span>
                                                        @member.Email
                                                    </span>
                                                </div>

                                                <button type="button"
                                                        class="danger-action"
                                                        disabled="@isRemovingCompanyMember"
                                                        @onclick="() => RequestMemberRemoval(member)">
                                                    Remove
                                                </button>
                                            </div>
                                        }
                                    </div>
                                }
                            </section>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(
                                memberBeingRemovedId))
                        {
                            <div class="member-removal-confirmation">
                                <p>
                                    Remove
                                    <strong>@memberBeingRemovedName</strong>
                                    from this company?
                                </p>

                                <p>
                                    Their login will remain active, but their
                                    account will become a guest account and
                                    will no longer use the company membership.
                                </p>

                                <div class="profile-actions">
                                    <button type="button"
                                            class="danger-action"
                                            disabled="@isRemovingCompanyMember"
                                            @onclick="ConfirmMemberRemovalAsync">
                                        @(isRemovingCompanyMember
                                            ? "Removing..."
                                            : "Yes, remove connection")
                                    </button>

                                    <button type="button"
                                            class="secondary-action"
                                            disabled="@isRemovingCompanyMember"
                                            @onclick="CancelMemberRemoval">
                                        Cancel
                                    </button>
                                </div>
                            </div>
                        }
                    </article>
                }

            </div>
        }
    </div>
</section>

@code {
    private bool isLoading = true;
    private bool isEditing;
    private bool isSaving;
    private bool isDeletingCard;
    private bool confirmCardDeletion;
    private bool isEditingCard;
    private bool isSavingCard;
    private bool confirmAccountDeletion;

    private string? errorMessage;
    private string? successMessage;
    private string? actionErrorMessage;

    private string identityUserId = string.Empty;
    private string displayName = "Account";
    private string firstName = string.Empty;
    private string surname = string.Empty;
    private string email = string.Empty;
    private string initials = "A";
    private string? businessName;

    private string accountType =
        MongoUserAccount.DefaultAccountType;

    private DateTime? createdAtUtc;

    private MongoUserAccount? mongoAccount;
    private MongoUserAccount? connectedOwnerAccount;
    private MongoMemberTimeline? membership;

    /*
     * The signed-in user's own saved card.
     *
     * Only this card is shown and only this card can
     * be deleted by the signed-in user.
     */
    private MongoSavedPaymentMethod? savedPaymentMethod;

    /*
     * The payment method belonging to whoever owns
     * the displayed membership.
     *
     * For referred pilots and trainers, this is the
     * connected company's payment method.
     *
     * It is used only to decide whether the membership
     * says "Renews" or "Expires". Its details are never
     * shown to the referred account.
     */
    private MongoSavedPaymentMethod?
        membershipPaymentMethod;

    private OwnerReferralCodes? ownerReferralCodes;

    private IReadOnlyList<CompanyMemberSummary>
        companyMembers =
            Array.Empty<CompanyMemberSummary>();

    private string? memberBeingRemovedId;
    private string? memberBeingRemovedName;
    private bool isRemovingCompanyMember;
    private ApplicationUser? identityUser;

    private EditAccountModel editModel = new();
    private CardEditModel cardEditModel = new();

    private bool IsOwnerAccount =>
        accountType is
            "owner_small" or
            "owner_large";

    private IReadOnlyList<CompanyMemberSummary> CompanyPilots =>
        companyMembers
            .Where(member =>
                member.AccountType == "pilot")
            .ToArray();

    private IReadOnlyList<CompanyMemberSummary> CompanyTrainers =>
        companyMembers
            .Where(member =>
                member.AccountType == "trainer")
            .ToArray();

    private int PilotLimit =>
        CompanyMemberLimits.GetLimit(
            accountType,
            "pilot");

    private int TrainerLimit =>
        CompanyMemberLimits.GetLimit(
            accountType,
            "trainer");


    private bool UsesCompanyMembership =>
        !string.IsNullOrWhiteSpace(
            mongoAccount?.OwnerIdentityUserId);

    private string ConnectedCompanyName
    {
        get
        {
            var connectedBusinessName =
                connectedOwnerAccount?
                    .BusinessName?
                    .Trim();

            return !string.IsNullOrWhiteSpace(
                    connectedBusinessName)
                ? connectedBusinessName
                : "your connected company";
        }
    }

    private string MembershipIdentityUserId =>
        UsesCompanyMembership
            ? mongoAccount!.OwnerIdentityUserId!
            : identityUserId;

    private string AccountTypeLabel =>
        accountType switch
        {
            "pilot" => "Pilot",
            "trainer" => "Trainer",
            "owner_small" => "Small Commercial",
            "owner_large" => "Large Commercial",
            _ => "Guest"
        };

    private string MemberSinceLabel =>
        createdAtUtc.HasValue
            ? FormatDate(createdAtUtc.Value)
            : "Not available";

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var principal =
            authenticationState.User;

        identityUserId =
            principal.FindFirstValue(
                ClaimTypes.NameIdentifier)
            ?? string.Empty;

        if (principal.Identity?.IsAuthenticated != true ||
            string.IsNullOrWhiteSpace(identityUserId))
        {
            errorMessage =
                "Your account could not be loaded. " +
                "Please sign in again.";

            isLoading = false;
            return;
        }

        email =
            principal.FindFirstValue(
                ClaimTypes.Email)
            ?? principal.Identity?.Name
            ?? string.Empty;

        displayName =
            GetFallbackName(principal);

        initials =
            BuildInitials(displayName);

        try
        {
            identityUser =
                await UserManager.GetUserAsync(
                    principal);

            /*
             * The MongoDB account must be loaded first
             * because it contains OwnerIdentityUserId.
             */
            mongoAccount =
                await MongoUserAccounts
                    .FindByIdentityUserIdAsync(
                        identityUserId);

            if (mongoAccount is not null)
            {
                firstName =
                    mongoAccount.FirstName?.Trim()
                    ?? string.Empty;

                surname =
                    mongoAccount.Surname?.Trim()
                    ?? string.Empty;

                businessName =
                    mongoAccount.BusinessName?.Trim();

                var storedName =
                    BuildDisplayName(
                        firstName,
                        surname);

                if (!string.IsNullOrWhiteSpace(storedName))
                {
                    displayName =
                        storedName;

                    initials =
                        BuildInitials(storedName);
                }

                if (!string.IsNullOrWhiteSpace(
                        mongoAccount.Email))
                {
                    email =
                        mongoAccount.Email;
                }

                accountType =
                    NormaliseAccountType(
                        mongoAccount.AccountType);

                createdAtUtc =
                    mongoAccount.CreatedAtUtc;
            }

            /*
             * Load the connected owner account so referred
             * pilots and trainers can see the owner's current
             * business name.
             */
            if (!string.IsNullOrWhiteSpace(
                    mongoAccount?.OwnerIdentityUserId))
            {
                connectedOwnerAccount =
                    await MongoUserAccounts
                        .FindByIdentityUserIdAsync(
                            mongoAccount.OwnerIdentityUserId);
            }

            /*
             * For referred accounts, this is the owner's ID.
             * For all other accounts, it is the signed-in
             * user's own ID.
             */
            var membershipIdentityUserId =
                MembershipIdentityUserId;

            var membershipTask =
                MemberTimelines
                    .FindByIdentityUserIdAsync(
                        membershipIdentityUserId);

            /*
             * Load the signed-in user's personal payment
             * method. This controls what card may be shown
             * or deleted on the page.
             */
            var personalPaymentMethodTask =
                SavedPaymentMethods
                    .FindByIdentityUserIdAsync(
                        identityUserId);

            /*
             * Load the membership owner's payment method
             * separately. This only determines whether the
             * membership renews or expires.
             */
            var membershipPaymentMethodTask =
                SavedPaymentMethods
                    .FindByIdentityUserIdAsync(
                        membershipIdentityUserId);

            await Task.WhenAll(
                membershipTask,
                personalPaymentMethodTask,
                membershipPaymentMethodTask);

            membership =
                await membershipTask;

            savedPaymentMethod =
                await personalPaymentMethodTask;

            membershipPaymentMethod =
                await membershipPaymentMethodTask;

            if (IsOwnerAccount)
            {
                var referralCodesTask =
                    ReferralCodeService
                        .GetOrCreateCodesAsync(
                            identityUserId);

                var companyMembersTask =
                    MongoUserAccounts
                        .FindLinkedMembersAsync(
                            identityUserId);

                await Task.WhenAll(
                    referralCodesTask,
                    companyMembersTask);

                ownerReferralCodes =
                    await referralCodesTask;

                companyMembers =
                    await companyMembersTask;
            }

            PopulateEditModel();
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Could not load profile data for user {UserId}.",
                identityUserId);

            errorMessage =
                "Your profile information is temporarily " +
                "unavailable. Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

