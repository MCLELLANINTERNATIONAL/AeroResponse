<header class="site-header">
    <div class="nav-container">

        <NavLink class="brand"
                 href=""
                 Match="NavLinkMatch.All"
                 aria-label="AeroResponse home">

            <img src="/images/logo2.png"
                 alt="AeroResponse"
                 class="brand-logo" />
        </NavLink>

        <input id="nav-toggle"
               class="nav-toggle"
               type="checkbox"
               aria-label="Toggle navigation" />

        <label class="nav-toggle-label"
               for="nav-toggle"
               aria-hidden="true">

            <span></span>
            <span></span>
            <span></span>
        </label>

        <nav class="primary-nav"
             aria-label="Primary navigation">

            <NavLink href=""
                     Match="NavLinkMatch.All">
                Home
            </NavLink>

            <NavLink href="membership">
                Membership
            </NavLink>

            <NavLink href="reports">
                Reports
            </NavLink>

            <NavLink href="aircraft">
                Aircraft
            </NavLink>

            <NavLink href="simulation">
                Simulation
            </NavLink>

            <NavLink href="scenarios">
                Scenarios
            </NavLink>
        </nav>

        <div class="account-actions">
            <AuthorizeView>
                <Authorized>
                    <UserAccountEmblem />

                    <form action="/Account/Logout"
                          method="post"
                          class="logout-action">

                        <AntiforgeryToken />

                        <input type="hidden"
                               name="ReturnUrl"
                               value="" />

                        <button type="submit"
                                class="logout-button">
                            Log Out
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <a class="login-button"
                       href="/Account/Login">
                        Login
                    </a>

                    <a class="signup-button"
                       href="/Account/Register">
                        Sign Up
                    </a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

    </div>
</header>