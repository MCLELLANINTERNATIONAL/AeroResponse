    private async Task SaveCardAsync()
    {
        if (isSavingCard || string.IsNullOrWhiteSpace(identityUserId))
        {
            return;
        }

        var cardDigits = new string(
            (cardEditModel.CardNumber ?? string.Empty)
                .Where(char.IsDigit)
                .ToArray());

        if (cardDigits.Length < 12 || cardDigits.Length > 19)
        {
            actionErrorMessage = "Enter a valid card number.";
            return;
        }

        isSavingCard = true;
        successMessage = null;
        actionErrorMessage = null;

        try
        {
            var method = new MongoSavedPaymentMethod
            {
                IdentityUserId = identityUserId,
                PaymentToken = $"demo_{Guid.NewGuid():N}",
                CardBrand = DetectCardBrand(cardDigits),
                LastFour = cardDigits[^4..],
                ExpiryDate = cardEditModel.ExpiryDate.Trim(),
                CardholderName = cardEditModel.CardholderName.Trim(),
                Country = cardEditModel.Country?.Trim() ?? string.Empty,
                PostalCode = cardEditModel.PostalCode?.Trim() ?? string.Empty,
                AddressLineOne = cardEditModel.AddressLineOne?.Trim() ?? string.Empty,
                City = cardEditModel.City?.Trim() ?? string.Empty,
                Region = cardEditModel.Region?.Trim() ?? string.Empty,
                UpdatedAtUtc = DateTime.UtcNow
            };

            await SavedPaymentMethods.UpsertAsync(method);

            savedPaymentMethod = method;

            if (!UsesCompanyMembership)
            {
                membershipPaymentMethod = method;
            }

            isEditingCard = false;
            cardEditModel = new CardEditModel();
            successMessage = "Your saved card has been updated.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Could not save payment method for user {UserId}.",
                identityUserId);

            actionErrorMessage =
                "Your card could not be saved. Please try again.";
        }
        finally
        {
            isSavingCard = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string DetectCardBrand(string cardDigits)
    {
        if (cardDigits.StartsWith("4"))
        {
            return "Visa";
        }

        if (cardDigits.StartsWith("5"))
        {
            return "Mastercard";
        }

        if (cardDigits.StartsWith("34") || cardDigits.StartsWith("37"))
        {
            return "American Express";
        }

        if (cardDigits.StartsWith("6"))
        {
            return "Discover";
        }

        return "Card";
    }

