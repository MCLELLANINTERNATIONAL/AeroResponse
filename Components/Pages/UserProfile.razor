    private async Task SaveAccountDetailsAsync()
    {
        if (isSaving)
        {
            return;
        }

        if (identityUser is null ||
            string.IsNullOrWhiteSpace(identityUserId))
        {
            actionErrorMessage =
                "Your account could not be updated. " +
                "Please sign in again.";

            return;
        }

        isSaving = true;
        successMessage = null;
        actionErrorMessage = null;

        try
        {
            var cleanFirstName =
                editModel.FirstName?.Trim()
                ?? string.Empty;

            var cleanSurname =
                editModel.Surname?.Trim()
                ?? string.Empty;

            var cleanEmail =
                editModel.Email?.Trim()
                ?? string.Empty;

            var existingUserWithEmail =
                await UserManager
                    .FindByEmailAsync(
                        cleanEmail);

            if (existingUserWithEmail is not null &&
                existingUserWithEmail.Id != identityUser.Id)
            {
                actionErrorMessage =
                    "That email address is already being used " +
                    "by another account.";

                return;
            }

            var currentIdentityEmail =
                await UserManager
                    .GetEmailAsync(
                        identityUser);

            var emailChanged =
                !string.Equals(
                    currentIdentityEmail,
                    cleanEmail,
                    StringComparison.OrdinalIgnoreCase);

            /*
             * Update the MongoDB profile.
             */
            await MongoUserAccounts
                .UpdateProfileAsync(
                    identityUserId,
                    cleanFirstName,
                    cleanSurname,
                    cleanEmail);

            /*
             * Update ASP.NET Identity when the email changed.
             */
            if (emailChanged)
            {
                var emailResult =
                    await UserManager
                        .SetEmailAsync(
                            identityUser,
                            cleanEmail);

                if (!emailResult.Succeeded)
                {
                    actionErrorMessage =
                        BuildIdentityErrorMessage(
                            emailResult);

                    return;
                }

                var usernameResult =
                    await UserManager
                        .SetUserNameAsync(
                            identityUser,
                            cleanEmail);

                if (!usernameResult.Succeeded)
                {
                    actionErrorMessage =
                        BuildIdentityErrorMessage(
                            usernameResult);

                    return;
                }
            }

            firstName =
                cleanFirstName;

            surname =
                cleanSurname;

            email =
                cleanEmail;

            displayName =
                BuildDisplayName(
                    firstName,
                    surname);

            if (string.IsNullOrWhiteSpace(displayName))
            {
                displayName =
                    GetNameFromEmail(email);
            }

            initials =
                BuildInitials(displayName);

            if (mongoAccount is not null)
            {
                mongoAccount.FirstName =
                    firstName;

                mongoAccount.Surname =
                    surname;

                mongoAccount.Email =
                    email;

                mongoAccount.NormalizedEmail =
                    email.ToUpperInvariant();
            }

            PopulateEditModel();

            isEditing = false;

            successMessage =
                emailChanged
                    ? "Your account details have been updated. " +
                      "Use your new email the next time you sign in."
                    : "Your account details have been updated.";
        }
        catch (MongoWriteException exception)
        {
            Logger.LogWarning(
                exception,
                "A MongoDB write error prevented an account " +
                "update for user {UserId}.",
                identityUserId);

            actionErrorMessage =
                "Your account details could not be saved. " +
                "The email address may already be in use.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Could not update profile for user {UserId}.",
                identityUserId);

            actionErrorMessage =
                "Your account details could not be saved. " +
                "Please try again.";
        }
        finally
        {
            isSaving = false;

            await InvokeAsync(
                StateHasChanged);
        }
    }

