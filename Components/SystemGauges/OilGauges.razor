<InstrumentBase Label="Oil Pressure"
                AriaLabel="Engine oil pressure gauge">

    <svg viewBox="0 0 240 240"
         role="img"
         aria-label="Oil pressure">

        <circle cx="120"
                cy="120"
                r="102"
                class="oil-gauge-case" />

        <circle cx="120"
                cy="120"
                r="86"
                class="oil-gauge-face" />

        <path d="M 62 162 A 70 70 0 0 1 178 162"
              class="oil-green-arc" />

        <line x1="120"
              y1="120"
              x2="120"
              y2="62"
              class="oil-needle"
              transform="@NeedleTransformPress" />

        <circle cx="120"
                cy="120"
                r="8"
                class="oil-hub" />

        <text x="120"
              y="174"
              text-anchor="middle"
              class="oil-value">
            @OilPressure.ToString("N0")
        </text>

        <text x="120"
              y="192"
              text-anchor="middle"
              class="oil-unit">
            PSI
        </text>

    </svg>

</InstrumentBase>
<InstrumentBase Label="Oil Temperature"
                AriaLabel="Engine oil temperature gauge">

    <svg viewBox="0 0 240 240"
         role="img"
         aria-label="Oil temperature">

        <circle cx="120"
                cy="120"
                r="102"
                class="oil-gauge-case" />

        <circle cx="120"
                cy="120"
                r="86"
                class="oil-gauge-face" />

        <path d="M 62 162 A 70 70 0 0 1 178 162"
              class="oil-green-arc" />

        <line x1="120"
              y1="120"
              x2="120"
              y2="62"
              class="oil-needle"
              transform="@NeedleTransformTemp" />

        <circle cx="120"
                cy="120"
                r="8"
                class="oil-hub" />

        <text x="120"
              y="174"
              text-anchor="middle"
              class="oil-value">
            @OilTemperature.ToString("N0")
        </text>

        <text x="120"
              y="192"
              text-anchor="middle"
              class="oil-unit">
            °F
        </text>

    </svg>

</InstrumentBase>

@code {
    [Parameter]
    public double OilTemperature { get; set; }

    [Parameter]
    public double OilPressure { get; set; }

    private string NeedleTransformPress
    {
        get
        {
            var clamped =
                Math.Clamp(OilPressure, 0, 100);

            var angle =
                -120 +
                (clamped / 100.0) * 240;

            return $"rotate({angle} 120 120)";
        }
    }

    private string NeedleTransformTemp
    {
        get
        {
            var clamped =
                Math.Clamp(OilTemperature, 0, 250);

            var angle =
                -120 +
                (clamped / 250.0) * 240;

            return $"rotate({angle} 120 120)";
        }
    }
}