@page "/Account/Register"
@layout AeroResponse.Components.Account.Shared.AuthLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using MongoDB.Driver
@using AeroResponse.Data
@using AeroResponse.Data.Mongo.Accounts

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject MongoUserAccountRepository MongoUserAccounts
@inject ILogger<Register> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Sign up | AeroResponse</PageTitle>

<section class="register-card">
    <header class="register-heading">
        <p class="register-eyebrow">
            Join AeroResponse
        </p>

        <h1>Create Your Account</h1>

        <p>
            Start building the skills and confidence needed
            for critical aviation moments.
        </p>
    </header>

    <StatusMessage Message="@Message" />

    <EditForm
        Model="Input"
        method="post"
        OnValidSubmit="RegisterUser"
        FormName="register"
        class="register-form">

        <DataAnnotationsValidator />

        <ValidationSummary
            class="validation-summary"
            role="alert" />

        <div class="name-grid">
            <div class="auth-field">
                <label for="Input.FirstName">
                    First Name
                </label>

                <div class="auth-input-wrapper">
                    <InputText
                        @bind-Value="Input.FirstName"
                        id="Input.FirstName"
                        class="auth-input"
                        autocomplete="given-name"
                        aria-required="true"
                        placeholder="Enter your first name" />

                    <svg
                        class="auth-input-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <circle cx="12" cy="8" r="4" />
                        <path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
                    </svg>
                </div>

                <ValidationMessage
                    For="() => Input.FirstName"
                    class="validation-message" />
            </div>

            <div class="auth-field">
                <label for="Input.Surname">
                    Surname
                </label>

                <div class="auth-input-wrapper">
                    <InputText
                        @bind-Value="Input.Surname"
                        id="Input.Surname"
                        class="auth-input"
                        autocomplete="family-name"
                        aria-required="true"
                        placeholder="Enter your surname" />

                    <svg
                        class="auth-input-icon"
                        viewBox="0 0 24 24"
                        aria-hidden="true">

                        <circle cx="12" cy="8" r="4" />
                        <path d="M4.5 21a7.5 7.5 0 0 1 15 0" />
                    </svg>
                </div>

                <ValidationMessage
                    For="() => Input.Surname"
                    class="validation-message" />
            </div>
        </div>

        <div class="auth-field">
            <label for="Input.Email">
                Email Address
            </label>

            <div class="auth-input-wrapper">
                <InputText
                    @bind-Value="Input.Email"
                    id="Input.Email"
                    class="auth-input"
                    autocomplete="email"
                    aria-required="true"
                    placeholder="Enter your email" />

                <svg
                    class="auth-input-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <path d="M3 5h18v14H3z" />
                    <path d="m3 7 9 6 9-6" />
                </svg>
            </div>

            <ValidationMessage
                For="() => Input.Email"
                class="validation-message" />
        </div>

        <div class="auth-field">
            <label for="Input.ReferenceCode">
                Reference Code

                <span class="optional-label">
                    Optional
                </span>
            </label>

            <div class="auth-input-wrapper">
                <InputText
                    @bind-Value="Input.ReferenceCode"
                    id="Input.ReferenceCode"
                    class="auth-input"
                    autocomplete="off"
                    placeholder="Enter a reference code" />

                <svg
                    class="auth-input-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <path d="M20 12 12 20 4 12l8-8 8 8Z" />
                    <circle cx="12" cy="12" r="1.5" />
                </svg>
            </div>

            <ValidationMessage
                For="() => Input.ReferenceCode"
                class="validation-message" />
        </div>

        <div class="auth-field">
            <label for="Input.Password">
                Password
            </label>

            <div class="auth-input-wrapper">
                <InputText
                    type="@passwordInputType"
                    @bind-Value="Input.Password"
                    id="Input.Password"
                    class="auth-input auth-input-password"
                    autocomplete="new-password"
                    aria-required="true"
                    placeholder="Create a password" />

                <svg
                    class="auth-input-icon auth-lock-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <rect
                        x="5"
                        y="10"
                        width="14"
                        height="10"
                        rx="2" />

                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>

                <button
                    type="button"
                    class="password-toggle"
                    aria-label="@passwordToggleLabel"
                    title="@passwordToggleLabel"
                    @onclick="TogglePasswordVisibility">

                    @if (showPassword)
                    {
                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true">

                            <path d="M3 3l18 18" />
                            <path d="M10.6 10.7a2 2 0 0 0 2.7 2.7" />
                            <path d="M9.9 4.2A10.8 10.8 0 0 1 12 4c5.5 0 9 5 9 5a16 16 0 0 1-2.4 2.9" />
                            <path d="M6.6 6.6C4.3 8.1 3 10 3 10s3.5 5 9 5c1.2 0 2.3-.2 3.3-.6" />
                        </svg>
                    }
                    else
                    {
                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true">

                            <path d="M3 12s3.5-5 9-5 9 5 9 5-3.5 5-9 5-9-5-9-5Z" />
                            <circle cx="12" cy="12" r="2.5" />
                        </svg>
                    }
                </button>
            </div>

            <p class="password-hint">
                Use at least 6 characters.
            </p>

            <ValidationMessage
                For="() => Input.Password"
                class="validation-message" />
        </div>

        <div class="auth-field">
            <label for="Input.ConfirmPassword">
                Confirm Password
            </label>

            <div class="auth-input-wrapper">
                <InputText
                    type="@confirmPasswordInputType"
                    @bind-Value="Input.ConfirmPassword"
                    id="Input.ConfirmPassword"
                    class="auth-input auth-input-password"
                    autocomplete="new-password"
                    aria-required="true"
                    placeholder="Confirm your password" />

                <svg
                    class="auth-input-icon auth-lock-icon"
                    viewBox="0 0 24 24"
                    aria-hidden="true">

                    <rect
                        x="5"
                        y="10"
                        width="14"
                        height="10"
                        rx="2" />

                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                </svg>

                <button
                    type="button"
                    class="password-toggle"
                    aria-label="@confirmPasswordToggleLabel"
                    title="@confirmPasswordToggleLabel"
                    @onclick="ToggleConfirmPasswordVisibility">

                    @if (showConfirmPassword)
                    {
                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true">

                            <path d="M3 3l18 18" />
                            <path d="M10.6 10.7a2 2 0 0 0 2.7 2.7" />
                            <path d="M9.9 4.2A10.8 10.8 0 0 1 12 4c5.5 0 9 5 9 5a16 16 0 0 1-2.4 2.9" />
                            <path d="M6.6 6.6C4.3 8.1 3 10 3 10s3.5 5 9 5c1.2 0 2.3-.2 3.3-.6" />
                        </svg>
                    }
                    else
                    {
                        <svg
                            viewBox="0 0 24 24"
                            aria-hidden="true">

                            <path d="M3 12s3.5-5 9-5 9 5 9 5-3.5 5-9 5-9-5-9-5Z" />
                            <circle cx="12" cy="12" r="2.5" />
                        </svg>
                    }
                </button>
            </div>

            <ValidationMessage
                For="() => Input.ConfirmPassword"
                class="validation-message" />
        </div>

        <label class="terms-option">
            <InputCheckbox
                @bind-Value="Input.AcceptTerms"
                class="terms-checkbox" />

            <span>
                I agree to the

                <a href="/terms" target="_blank">
                    Terms of Service
                </a>

                and

                <a href="/privacy" target="_blank">
                    Privacy Policy
                </a>.
            </span>
        </label>

        <ValidationMessage
            For="() => Input.AcceptTerms"
            class="validation-message terms-validation" />

        <button
            type="submit"
            class="primary-auth-button"
            disabled="@isSubmitting">

            <img
                src="/images/aircraft.png"
                alt=""
                aria-hidden="true" />

            @if (isSubmitting)
            {
                <span>Creating Account...</span>
            }
            else
            {
                <span>Create Account</span>
            }
        </button>

        <div class="auth-divider">
            <span>or continue with</span>
        </div>

        <ExternalLoginPicker />

        <p class="auth-switch-message">
            Already have an account?

            <a href="@LoginUrl">
                Sign in
            </a>
        </p>
    </EditForm>
</section>

@code {
    private IEnumerable<IdentityError>? identityErrors;
    private bool showPassword;
    private bool showConfirmPassword;
    private bool isSubmitting;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message =>
        identityErrors is null
            ? null
            : $"Error: {string.Join(
                ", ",
                identityErrors.Select(
                    error => error.Description))}";

    private string passwordInputType =>
        showPassword
            ? "text"
            : "password";

    private string confirmPasswordInputType =>
        showConfirmPassword
            ? "text"
            : "password";

    private string passwordToggleLabel =>
        showPassword
            ? "Hide password"
            : "Show password";

    private string confirmPasswordToggleLabel =>
        showConfirmPassword
            ? "Hide confirmation password"
            : "Show confirmation password";

    private string LoginUrl =>
        NavigationManager.GetUriWithQueryParameters(
            "/Account/Login",
            new Dictionary<string, object?>
            {
                ["ReturnUrl"] = ReturnUrl
            });

    protected override void OnInitialized()
    {
        Input ??= new InputModel();
    }

    public async Task RegisterUser(
        EditContext editContext)
    {
        if (isSubmitting)
        {
            return;
        }

        isSubmitting = true;
        identityErrors = null;

        ApplicationUser? user = null;

        try
        {
            user = CreateUser();

            user.FirstName =
                Input.FirstName.Trim();

            user.Surname =
                Input.Surname.Trim();

            user.ReferenceCode =
                string.IsNullOrWhiteSpace(
                    Input.ReferenceCode)
                    ? null
                    : Input.ReferenceCode.Trim();

            var normalisedEmail =
                Input.Email.Trim();

            await UserStore.SetUserNameAsync(
                user,
                normalisedEmail,
                CancellationToken.None);

            var emailStore =
                GetEmailStore();

            await emailStore.SetEmailAsync(
                user,
                normalisedEmail,
                CancellationToken.None);

            var identityResult =
                await UserManager.CreateAsync(
                    user,
                    Input.Password);

            if (!identityResult.Succeeded)
            {
                identityErrors =
                    identityResult.Errors;

                return;
            }

            var mongoAccount =
                new MongoUserAccount
                {
                    IdentityUserId =
                        user.Id,

                    FirstName =
                        user.FirstName,

                    Surname =
                        user.Surname,

                    Email =
                        normalisedEmail,

                    NormalizedEmail =
                        user.NormalizedEmail
                        ?? normalisedEmail
                            .ToUpperInvariant(),

                    PasswordHash =
                        user.PasswordHash
                        ?? string.Empty,

                    AccountType =
                        MongoUserAccount
                            .DefaultAccountType,

                    CreatedAtUtc =
                        DateTime.UtcNow
                };

            /*
             * ReferenceCode is deliberately not stored
             * inside the MongoDB account document.
             */
            try
            {
                await MongoUserAccounts.CreateAsync(
                    mongoAccount);
            }
            catch (Exception mongoException)
                when (
                    mongoException is MongoException
                    or TimeoutException)
            {
                /*
                 * Remove the Identity account if its
                 * MongoDB profile could not be created.
                 */
                var deleteResult =
                    await UserManager.DeleteAsync(
                        user);

                if (!deleteResult.Succeeded)
                {
                    Logger.LogError(
                        "Could not roll back Identity user " +
                        "{UserId} after MongoDB account " +
                        "creation failed.",
                        user.Id);
                }

                Logger.LogError(
                    mongoException,
                    "MongoDB account creation failed " +
                    "for {Email}.",
                    normalisedEmail);

                identityErrors =
                [
                    new IdentityError
                    {
                        Code = "MongoDbUnavailable",
                        Description =
                            "The account database is currently " +
                            "unavailable. Please try again."
                    }
                ];

                return;
            }

            Logger.LogInformation(
                "User {Email} created a new guest account.",
                normalisedEmail);

            /*
             * Immediately sign in the newly created
             * user. No confirmation page is shown.
             */
            await SignInManager.SignInAsync(
                user,
                isPersistent: false);

            /*
             * Redirect directly to the home page.
             * The home page will now render the
             * authenticated navigation controls.
             */
            RedirectManager.RedirectTo("/");
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Unexpected registration error for {Email}.",
                Input.Email);

            /*
             * If Identity creation succeeded but another
             * unexpected operation failed before sign-in,
             * attempt to remove the incomplete account.
             */
            if (user is not null)
            {
                var existingUser =
                    await UserManager.FindByIdAsync(
                        user.Id);

                if (existingUser is not null)
                {
                    var deleteResult =
                        await UserManager.DeleteAsync(
                            existingUser);

                    if (!deleteResult.Succeeded)
                    {
                        Logger.LogError(
                            "Could not roll back incomplete " +
                            "Identity user {UserId}.",
                            user.Id);
                    }
                }
            }

            identityErrors =
            [
                new IdentityError
                {
                    Code = "RegistrationFailed",
                    Description =
                        "An unexpected error occurred while " +
                        "creating your account. Please try again."
                }
            ];
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void TogglePasswordVisibility()
    {
        showPassword =
            !showPassword;
    }

    private void ToggleConfirmPasswordVisibility()
    {
        showConfirmPassword =
            !showConfirmPassword;
    }

    private ApplicationUser CreateUser()
    {
        try
        {
            return Activator
                .CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException(
                $"Can't create an instance of " +
                $"'{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' " +
                "is not an abstract class and has a " +
                "parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser>
        GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException(
                "The default UI requires a user store " +
                "with email support.");
        }

        return
            (IUserEmailStore<ApplicationUser>)
            UserStore;
    }

    private sealed class InputModel
    {
        [Required(
            ErrorMessage =
                "Please enter your first name.")]
        [StringLength(
            100,
            ErrorMessage =
                "First name cannot exceed 100 characters.")]
        [Display(Name = "First name")]
        public string FirstName { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Please enter your surname.")]
        [StringLength(
            100,
            ErrorMessage =
                "Surname cannot exceed 100 characters.")]
        [Display(Name = "Surname")]
        public string Surname { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Please enter your email address.")]
        [EmailAddress(
            ErrorMessage =
                "Please enter a valid email address.")]
        [Display(Name = "Email address")]
        public string Email { get; set; } =
            string.Empty;

        [StringLength(
            100,
            ErrorMessage =
                "Reference code cannot exceed " +
                "100 characters.")]
        [Display(Name = "Reference code")]
        public string? ReferenceCode { get; set; }

        [Required(
            ErrorMessage =
                "Please create a password.")]
        [StringLength(
            100,
            ErrorMessage =
                "The password must be between {2} and " +
                "{1} characters long.",
            MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "Password")]
        public string Password { get; set; } =
            string.Empty;

        [Required(
            ErrorMessage =
                "Please confirm your password.")]
        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare(
            nameof(Password),
            ErrorMessage =
                "The password and confirmation password " +
                "do not match.")]
        public string ConfirmPassword { get; set; } =
            string.Empty;

        [Range(
            typeof(bool),
            "true",
            "true",
            ErrorMessage =
                "You must accept the terms before " +
                "creating an account.")]
        public bool AcceptTerms { get; set; }
    }
}