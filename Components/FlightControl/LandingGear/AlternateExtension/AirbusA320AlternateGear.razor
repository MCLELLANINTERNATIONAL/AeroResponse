@using AeroResponse.Models
@using AeroResponse.Simulation

<AlternateGearPanel>

    <svg viewBox="0 0 320 220"
         class="alternate-gear-svg"
         role="img"
         aria-label="Airbus A320 gravity landing gear extension">

        <rect x="10"
              y="10"
              width="300"
              height="200"
              rx="12"
              class="panel-face" />

        <text x="160"
              y="38"
              text-anchor="middle"
              class="panel-title">
            GRAVITY GEAR EXTENSION
        </text>

        <circle cx="160"
                cy="120"
                r="58"
                class="crank-ring" />

        <line x1="160"
              y1="120"
              x2="160"
              y2="72"
              class="crank-handle"
              transform="@CrankTransform" />

        <circle cx="160"
                cy="120"
                r="10"
                class="crank-hub" />

        <text x="160"
              y="194"
              text-anchor="middle"
              class="panel-status">
            TURNS @turnCount / 3
        </text>

    </svg>

    <button type="button"
            class="alternate-gear-button"
            disabled="@State.AlternateGearExtensionCompleted"
            @onclick="TurnCrank">

        @(State.AlternateGearExtensionCompleted
            ? "GEAR EXTENSION COMPLETE"
            : "TURN GRAVITY EXTENSION")

    </button>

</AlternateGearPanel>

@code {
    [Parameter, EditorRequired]
    public CockpitState State { get; set; } = default!;

    private int turnCount;

    private string CrankTransform =>
        $"rotate({turnCount * 120} 160 120)";

    private void TurnCrank()
    {
        State.AlternateGearExtensionActivated = true;

        if (turnCount < 3)
        {
            turnCount++;
        }

        if (turnCount < 3)
        {
            return;
        }

        foreach (var gear in State.LandingGears)
        {
            gear.Status =
                LandingGearStatusValue.DownAndLocked;
        }

        State.AlternateGearExtensionCompleted = true;
    }
}