@page "/reports"
@attribute [Authorize(Policy = AccountPermissions.PilotPages)]
@rendermode InteractiveServer
@implements IDisposable

@using System.IO
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop

@inject PerformanceDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PilotReportAccessService PilotReportAccess
@inject IJSRuntime JS

<PageTitle>PILOT RESULTS DASHBOARD</PageTitle>


@* =========================================================
LOADING STATE
========================================================= *@

@if (_loading)
{
    <div class="reports-loading">
        Loading pilot performance…
    </div>
}


@* =========================================================
EMPTY DASHBOARD STATE
========================================================= *@

else if (_dashboard?.Latest is null)
{
    <div class="reports-empty">

        <h1>
            No results yet
        </h1>

        <p>
            Complete a practice scenario to populate this dashboard.
        </p>

    </div>
}


@* =========================================================
MAIN DASHBOARD
========================================================= *@

else
{
    var report = _dashboard.Latest;

    <main
    id="pilot-performance-report"
    class="reports-page">


    @* =====================================================
    DASHBOARD HEADER
    ===================================================== *@

    <header class="reports-header">

        <div>

            <h1>
                PILOT RESULTS DASHBOARD
            </h1>

            <p>
                Review your performance and achievements
            </p>

        </div>


        <div class="pilot-chip">

            <span class="pilot-avatar">
                ✈
            </span>

            <div>

                <strong>
                    @report.PilotName
                </strong>

                <small>
                    Professional Pilot
                </small>

            </div>

        </div>

    </header>


    @* =====================================================
    DASHBOARD NAVIGATION
    ===================================================== *@

    <nav class="reports-tabs">

        <NavLink
        href="@PilotReportHref("/reports")"
        Match="NavLinkMatch.All">
        ◉ Overview
    </NavLink>

    <NavLink href="@PilotReportHref("/reports/flight-logs")">
        ✈ Flight Logs
    </NavLink>

    <NavLink href="@PilotReportHref("/reports/scoring")">
        ⚙ Scoring
    </NavLink>

    <NavLink href="@PilotReportHref("/reports/analytics")">
        ▥ Analytics
    </NavLink>

    <NavLink href="@PilotReportHref("/reports/feedback")">
        ✪ Feedback
    </NavLink>

    <NavLink href="@PilotReportHref("/reports/badges")">
        🏆 Badges
    </NavLink>
        <AuthorizeView Policy="@AccountPermissions.TrainerReports">
            <Authorized>
                <NavLink href="/reports/instructor">
                    👨‍✈ Instructor Reports
                </NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@AccountPermissions.AdminPages">
            <Authorized>
                <NavLink href="/reports/admin">
                    ▦ Admin Reports
                </NavLink>
            </Authorized>
        </AuthorizeView>


    <button
    id="download-report-button"
    type="button"
    @onclick="DownloadReportAsync">

    ⬇ Download PDF

</button>

</nav>


@* =====================================================
TOP DASHBOARD GRID
===================================================== *@

<section
id="overview"
class="reports-grid top-grid">


@* =================================================
OVERALL SCORE CARD
================================================= *@

<article class="report-card score-card">

    <h2>
        Overall Score
    </h2>


    <div class="score-main">

        <div
        class="score-ring"
        style="--score:@report.OverallScore">

        <span>
            @report.OverallScore%
        </span>

        <small>
            @(report.Passed
            ? "Great Performance!"
            : "Keep Practising")
        </small>

    </div>


    <div class="score-copy">

        <small>
            Total Score
        </small>

        <strong>
            @(report.OverallScore * 10) / 1000
        </strong>


        <small>
            Passing Score
        </small>

        <b>
            70% (700/1000)
        </b>


        <small>
            Rank
        </small>

        <strong>
            Top @RankPercent%
        </strong>

        <em>
            of all users
        </em>

    </div>

</div>


<div class="pass-banner">

    🏆

    <span>

        <strong>
            @(report.Passed
            ? "You passed this scenario!"
            : "Scenario not yet passed")
        </strong>

        <small>
            @(report.Passed
            ? "Keep up the great work."
            : "Review feedback and try again.")
        </small>

    </span>

</div>

</article>


@* =================================================
SCORE BREAKDOWN CARD
================================================= *@

<article
id="scoring"
class="report-card">

<h2>
    Score Breakdown
</h2>


@* PROCEDURAL ACCURACY *@

<div class="metric">

    <div class="metric-result">

        <span>
            Procedural Accuracy
        </span>

        <strong>
            @report.ProcedureAccuracyScore%
        </strong>

    </div>

    <div class="metric-track">

        <div
        class="metric-fill blue"
        style="width: @report.ProcedureAccuracyScore%;">
    </div>

</div>

</div>


@* DECISION MAKING *@

<div class="metric">

    <div class="metric-result">

        <span>
            Decision Making
        </span>

        <strong>
            @report.DecisionMakingScore%
        </strong>

    </div>

    <div class="metric-track">

        <div
        class="metric-fill green"
        style="width: @report.DecisionMakingScore%;">
    </div>

</div>

</div>


@* CHECKLIST USAGE *@

<div class="metric">

    <div class="metric-result">

        <span>
            Checklist Usage
        </span>

        <strong>
            @report.ChecklistUsageScore%
        </strong>

    </div>

    <div class="metric-track">

        <div
        class="metric-fill orange"
        style="width: @report.ChecklistUsageScore%;">
    </div>

</div>

</div>


@* TIME MANAGEMENT *@

<div class="metric">

    <div class="metric-result">

        <span>
            Time Management
        </span>

        <strong>
            @report.TimeManagementScore%
        </strong>

    </div>

    <div class="metric-track">

        <div
        class="metric-fill purple"
        style="width: @report.TimeManagementScore%;">
    </div>

</div>

</div>


@* COMMUNICATION *@

<div class="metric">

    <div class="metric-result">

        <span>
            Communication
        </span>

        <strong>
            @report.CommunicationScore%
        </strong>

    </div>

    <div class="metric-track">

        <div
        class="metric-fill cyan"
        style="width: @report.CommunicationScore%;">
    </div>

</div>

</div>


<a
class="card-link"
href="@PilotReportHref("/reports/scoring")">

View scoring details →

</a>

</article>


@* =================================================
SCENARIO SUMMARY CARD
================================================= *@

<article class="report-card scenario-summary">

    <h2>
        Scenario Summary
    </h2>


    <div class="scenario-title">

        <span>
            ✈
        </span>


        <div>

            <strong>
                @report.ScenarioName
            </strong>


            <small>
                Completed on:
                @(report.CompletedAt
                .ToLocalTime()
                .ToString(
                "dd MMM yyyy 'at' HH:mm"))
            </small>


            <small>
                Scenario Difficulty:
                @report.Difficulty
            </small>

        </div>


        <b>
            EMERGENCY
        </b>

    </div>


    <hr />


    @InfoRow(
    "◷",
    "Reaction Time",
    $"{report.ReactionTimeSeconds}s")


    @InfoRow(
    "◷",
    "Total Time",
    Duration(report))


    @InfoRow(
    "◷",
    "Start Time",
    report.StartedAt
    .ToLocalTime()
    .ToString("HH:mm:ss"))


    @InfoRow(
    "◷",
    "End Time",
    report.CompletedAt
    .ToLocalTime()
    .ToString("HH:mm:ss"))


    @InfoRow(
    "☑",
    "Actions Taken",
    report.ActionsTaken.ToString())


    @InfoRow(
    "▣",
    "Checklist Used",
    $"{report.ChecklistUsageScore}%")


    @InfoRow(
    "⚠",
    "Safety-Critical Errors",
    report.SafetyCriticalErrors.ToString())


    @InfoRow(
    "🏁",
    "Result",
    report.Passed
    ? "Passed"
    : "Review Required")

</article>

</section>


@* =====================================================
BOTTOM DASHBOARD GRID
===================================================== *@

<section class="reports-grid bottom-grid">


    @* =================================================
    PERFORMANCE ANALYTICS
    ================================================= *@

    <article
    id="analytics"
    class="report-card analytics-card">

    <div class="card-heading">

        <h2>
            Performance Analytics
        </h2>

        <span>
            Last 10 Scenarios
        </span>

    </div>


    <svg
    class="trend-chart"
    viewBox="0 0 620 260"
    role="img"
    aria-label="Pilot performance trend">


    @* GRID *@

    <g class="grid-lines">

        @for (var y = 0; y <= 4; y++)
        {
            <line
            x1="45"
            y1="@(25 + y * 48)"
            x2="600"
            y2="@(25 + y * 48)" />
        }

    </g>


    @* REAL RUNNING AVERAGE *@

    <polyline
    class="average-line"
    points="@AveragePoints" />


    @* ACTUAL PILOT SCORES *@

    <polyline
    class="score-line"
    points="@ScorePoints" />


    @foreach (var point in ChartPoints)
    {
        <circle
        cx="@point.X"
        cy="@point.Y"
        r="4" />
    }

</svg>


<div class="chart-legend">

    <span>
        ● Your Score
    </span>

    <span>
        ● Running Average
    </span>

</div>


<div class="stat-row">

    <div>

        <small>
            Average Score
        </small>

        <strong>
            @_dashboard.AverageScore%
        </strong>

    </div>


    <div>

        <small>
            Best Score
        </small>

        <strong>
            @_dashboard.BestScore%
        </strong>

    </div>


    <div>

        <small>
            Total Scenarios
        </small>

        <strong>
            @_dashboard.Reports.Count
        </strong>

    </div>


    <div>

        <small>
            Improvement
        </small>

        <strong class="@ImprovementCssClass">
            @Signed(_dashboard.Improvement)%
        </strong>

    </div>

</div>


<a
class="card-link"
href="@PilotReportHref("/reports/analytics")">

View full analytics →

</a>

</article>


@* =================================================
FEEDBACK CARD
================================================= *@

<article
id="feedback"
class="report-card feedback-card">

<h2>
    Feedback
</h2>


@* =================================================
FEEDBACK TABS
================================================= *@

<div
class="feedback-tabs"
role="tablist"
aria-label="Feedback type">


<button
type="button"
role="tab"
aria-selected="@(_activeFeedbackTab == FeedbackTab.Instructor)"
class="@GetFeedbackTabClass(FeedbackTab.Instructor)"
@onclick="() => SelectFeedbackTab(FeedbackTab.Instructor)">

Instructor Feedback

</button>


<button
type="button"
role="tab"
aria-selected="@(_activeFeedbackTab == FeedbackTab.Ai)"
class="@GetFeedbackTabClass(FeedbackTab.Ai)"
@onclick="() => SelectFeedbackTab(FeedbackTab.Ai)">

AI Feedback

</button>

</div>


@* =================================================
INSTRUCTOR FEEDBACK
================================================= *@

@if (_activeFeedbackTab == FeedbackTab.Instructor)
{
    <section
    class="feedback-tab-content"
    role="tabpanel">


    <div class="@GetInstructorFeedbackClass(report)">

        <strong>
            @GetInstructorHeading(report)
        </strong>


        @if (string.IsNullOrWhiteSpace(
        report.Feedback))
        {
            <p>
                No instructor feedback is available
                for this assessment.
            </p>
        }
        else
        {
            <p>
                @report.Feedback
            </p>
        }

    </div>


    <h3>
        Areas to Improve
    </h3>


    <ul>

        @foreach (
        var item in
        ImprovementItems(report))
        {
            <li>
                @item
            </li>
        }

    </ul>


    <a
    class="card-link"
    href="@PilotReportHref("/reports/feedback")">

    View full instructor feedback →

</a>

</section>
}


@* =================================================
AI FEEDBACK
================================================= *@

else
{
    <section
    class="feedback-tab-content"
    role="tabpanel">


    <div class="feedback-ai">

        <h3>
            AI Performance Analysis
        </h3>


        @if (string.IsNullOrWhiteSpace(
        report.AiFeedback))
        {
            <p>
                No AI-generated analysis is available
                for this assessment.
            </p>
        }
        else
        {
            <p>
                @report.AiFeedback
            </p>
        }

    </div>


    <h3>
        AI Recommended Focus
    </h3>


    <ul>

        @foreach (
        var item in
        AiImprovementItems(report))
        {
            <li>
                @item
            </li>
        }

    </ul>


    <a
    class="card-link"
    href="@PilotReportHref("/reports/feedback")">

    View full AI feedback →

</a>

</section>
}

</article>


@* =================================================
BADGES AND ACHIEVEMENTS
================================================= *@

<article
id="badges"
class="report-card badges-card">

<div class="card-heading">

    <h2>
        Badges Earned
    </h2>

    <span>
        @_dashboard.Achievements.Count earned
    </span>

</div>


@if (_dashboard.Achievements.Count == 0)
{
    <div class="reports-empty">

        <h3>
            No badges earned yet
        </h3>

        <p>
            Continue completing training scenarios
            to unlock achievements.
        </p>

    </div>
}
else
{
    <div class="badges-grid">

        @foreach (
        var badge in
        _dashboard.Achievements)
        {
            <div class="badge">

                <div class="badge-icon">
                    @badge.Icon
                </div>

                <strong>
                    @badge.Name
                </strong>

                <small>
                    Earned:
                    @(badge.EarnedAt
                    .ToLocalTime()
                    .ToString(
                    "dd MMM yyyy"))
                </small>

            </div>
        }


        @if (!HasPerfectScoreBadge)
        {
            <div class="badge locked">

                <div class="badge-icon">
                    🔒
                </div>

                <strong>
                    Perfect Score
                </strong>

                <small>
                    Score 100% in any scenario
                </small>

            </div>
        }

    </div>
}


<a
class="card-link"
href="@PilotReportHref("/reports/badges")">

View all achievements →

</a>

</article>

</section>


@* =====================================================
LIVE DASHBOARD STATUS
===================================================== *@

<p class="live-note">
    ● Live dashboard — refreshes automatically when a pilot
    completes a practice scenario.
</p>

</main>
}

@code {

    [SupplyParameterFromQuery(Name = "pilotUserId")]
    public string? PilotUserId { get; set; }

    /* =====================================================================
       CURRENT PILOT

       Authentication is not yet fully implemented.

       When an authenticated ASP.NET Identity user exists, use their
       NameIdentifier.

       Until authentication is completed, use debug-pilot so Simulation
       and all pilot-facing reporting pages query the same records.
       ===================================================================== */

    private string _currentUserId =
        string.Empty;


    /* =====================================================================
       DASHBOARD STATE
       ===================================================================== */

    private PerformanceDashboardVm? _dashboard;

    private bool _loading = true;


    private FeedbackTab _activeFeedbackTab =
        FeedbackTab.Instructor;


    /* =====================================================================
       INITIALIZATION
       ===================================================================== */

    protected override async Task OnInitializedAsync()
    {
        /*
         * Resolve the current pilot.
         */
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var principal =
            authenticationState.User;


        _currentUserId =
            await PilotReportAccess.ResolvePilotUserIdAsync(
                principal,
                PilotUserId)
            ?? string.Empty;


        /*
         * Listen for newly completed simulation reports.
         */
        PerformanceFeed.ReportSaved +=
            OnReportSaved;


        /*
         * Load this pilot's dashboard.
         */
        await LoadAsync();
    }


    /* =====================================================================
       LIVE REPORT UPDATES
       ===================================================================== */

    private async void OnReportSaved(
        string userId)
    {
        /*
         * Only refresh this dashboard when the saved report belongs
         * to the pilot currently viewing it.
         */
        if (!string.Equals(
                userId,
                _currentUserId,
                StringComparison.Ordinal))
        {
            return;
        }


        await InvokeAsync(
            async () =>
            {
                await LoadAsync();

                StateHasChanged();
            });
    }


    /* =====================================================================
       DASHBOARD LOADING
       ===================================================================== */

    private async Task LoadAsync()
    {
        try
        {
            _loading =
                true;


            /*
             * Uses exactly the same UserId as Flight Logs,
             * Scoring, Analytics, Feedback and Badges.
             */
            _dashboard =
                await DashboardService
                    .GetDashboardAsync(
                        _currentUserId);
        }
        finally
        {
            _loading =
                false;
        }
    }


    /* =====================================================================
       RANK
       ===================================================================== */

    private int RankPercent =>
        Math.Max(
            1,
            100 -
            (_dashboard?.Latest?.OverallScore ?? 0));


    /* =====================================================================
       INFORMATION ROW
       ===================================================================== */

    private static MarkupString InfoRow(
        string icon,
        string label,
        string value)
    {
        return new MarkupString(
            $"""
            <div class="info-row">
                <span>{icon}</span>
                <label>{label}</label>
                <strong>{value}</strong>
            </div>
            """);
    }


    /* =====================================================================
       SIMULATION DURATION
       ===================================================================== */

    private static string Duration(
        SimulationReport report)
    {
        var duration =
            report.CompletedAt -
            report.StartedAt;


        if (duration < TimeSpan.Zero)
        {
            return "00:00";
        }


        return duration.ToString(
            @"mm\:ss");
    }


    /* =====================================================================
        ACTUAL PILOT SCORE CHART
       ===================================================================== */

    private IReadOnlyList<(double X, double Y)>
        ChartPoints
    {
        get
        {
            var reports =
                _dashboard?.ChartReports;


            if (reports is null ||
                reports.Count == 0)
            {
                return Array.Empty<
                    (double X, double Y)>();
            }


            return reports
                .Select(
                    (item, index) =>
                    {
                        var denominator =
                            Math.Max(
                                1,
                                reports.Count - 1);


                        var x =
                            45 +
                            index *
                            (555.0 / denominator);


                        var score =
                            Math.Clamp(
                                item.OverallScore,
                                0,
                                100);


                        var y =
                            217 -
                            score *
                            1.8;


                        return (
                            X: x,
                            Y: y);
                    })
                .ToList();
        }
    }


    /* =====================================================================
        SCORE POLYLINE
       ===================================================================== */

    private string ScorePoints =>
        string.Join(
            " ",
            ChartPoints.Select(
                point =>
                    $"{point.X:F1},{point.Y:F1}"));


    /* =====================================================================
        REAL RUNNING AVERAGE

        This replaces the old fabricated:
           55 + index * 2

        Each point now represents the actual running average of the
        pilot's displayed last-ten simulation results.
       ===================================================================== */

    private IReadOnlyList<(double X, double Y)>
        AverageChartPoints
    {
        get
        {
            var reports =
                _dashboard?.ChartReports;


            if (reports is null ||
                reports.Count == 0)
            {
                return Array.Empty<
                    (double X, double Y)>();
            }


            var points =
                new List<(double X, double Y)>();


            for (var index = 0;
                index < reports.Count;
                index++)
            {
                var denominator =
                    Math.Max(
                        1,
                        reports.Count - 1);


                var x =
                    45 +
                    index *
                    (555.0 / denominator);


                /*
                 * Actual average from the first displayed attempt
                 * through the current displayed attempt.
                 */
                var runningAverage =
                    reports
                        .Take(index + 1)
                        .Average(
                            item =>
                                item.OverallScore);


                var clampedAverage =
                    Math.Clamp(
                        runningAverage,
                        0,
                        100);


                var y =
                    217 -
                    clampedAverage *
                    1.8;


                points.Add(
                    (
                        X: x,
                        Y: y
                    ));
            }


            return points;
        }
    }


    /* =====================================================================
        AVERAGE POLYLINE
       ===================================================================== */

    private string AveragePoints =>
        string.Join(
            " ",
            AverageChartPoints.Select(
                point =>
                    $"{point.X:F1},{point.Y:F1}"));


    /* =====================================================================
        IMPROVEMENT
       ===================================================================== */

    private string ImprovementCssClass =>
        (_dashboard?.Improvement ?? 0) >= 0
            ? "positive"
            : "negative";


    private static string Signed(
        int number)
    {
        return number >= 0
            ? $"+{number}"
            : number.ToString();
    }


    /* =====================================================================
        INSTRUCTOR IMPROVEMENT ITEMS
       ===================================================================== */

    private static IEnumerable<string>
        ImprovementItems(
            SimulationReport report)
    {
        var hasImprovementItem =
            false;


        /*
         * No pilot response.
         */
        if (report.ActionsTaken == 0)
        {
            hasImprovementItem =
                true;

            yield return
                "Begin the response immediately after the emergency warning appears.";
        }


        /*
         * Reaction time.
         */
        if (report.ReactionTimeSeconds > 10)
        {
            hasImprovementItem =
                true;

            yield return
                $"Improve time to identify the primary failure " +
                $"({report.ReactionTimeSeconds - 10}s slower than target).";
        }


        /*
         * Procedural accuracy.
         */
        if (report.ProcedureAccuracyScore < 95)
        {
            hasImprovementItem =
                true;

            yield return
                "Review the emergency procedure and maintain the correct action sequence.";
        }


        /*
         * Checklist usage.
         */
        if (report.ChecklistUsageScore < 90)
        {
            hasImprovementItem =
                true;

            yield return
                "Use the emergency checklist consistently once immediate memory actions are complete.";
        }


        /*
         * Communication.
         */
        if (report.CommunicationScore < 90)
        {
            hasImprovementItem =
                true;

            yield return
                "Consider declaring the emergency and requesting assistance earlier.";
        }


        /*
         * Decision making.
         */
        if (report.DecisionMakingScore < 85)
        {
            hasImprovementItem =
                true;

            yield return
                "Prioritise safety-critical actions before secondary cockpit tasks.";
        }


        /*
         * Safety-critical errors.
         */
        if (report.SafetyCriticalErrors > 0)
        {
            hasImprovementItem =
                true;

            yield return
                "Review safety-critical actions before the next attempt.";
        }


        /*
         * No improvement issues.
         */
        if (!hasImprovementItem)
        {
            yield return
                "Continue maintaining the same high standard in future scenarios.";
        }
    }


    /* =====================================================================
        FEEDBACK TABS
       ===================================================================== */

    private void SelectFeedbackTab(
        FeedbackTab tab)
    {
        _activeFeedbackTab =
            tab;
    }


    private string GetFeedbackTabClass(
        FeedbackTab tab)
    {
        return _activeFeedbackTab ==
            tab
            ? "feedback-tab-button active"
            : "feedback-tab-button";
    }


    /* =====================================================================
        INSTRUCTOR FEEDBACK
       ===================================================================== */

    private static string
        GetInstructorHeading(
            SimulationReport report)
    {
        if (report.ActionsTaken == 0)
        {
            return "Review Required";
        }


        if (!report.Passed)
        {
            return
                "Further Practice Required";
        }


        return report.OverallScore >= 85
            ? "☆ Great Job!"
            : "Good Attempt";
    }


    private static string
        GetInstructorFeedbackClass(
            SimulationReport report)
    {
        if (report.ActionsTaken == 0 ||
            !report.Passed)
        {
            return
                "feedback-good feedback-review";
        }


        return "feedback-good";
    }


    /* =====================================================================
        AI RECOMMENDED FOCUS
       ===================================================================== */

    private static IEnumerable<string>
        AiImprovementItems(
            SimulationReport report)
    {
        var hasRecommendation =
            false;


        /*
         * No response.
         */
        if (report.ActionsTaken == 0)
        {
            hasRecommendation =
                true;

            yield return
                "Begin the response immediately after the emergency warning appears.";
        }


        /*
         * Procedural accuracy.
         */
        if (report.ProcedureAccuracyScore < 85)
        {
            hasRecommendation =
                true;

            yield return
                "Review the gold-standard procedure and practise the exact action sequence.";
        }


        /*
         * Time management.
         */
        if (report.TimeManagementScore < 80)
        {
            hasRecommendation =
                true;

            yield return
                "Reduce the delay between the warning and the first cockpit action.";
        }


        /*
         * Decision making.
         */
        if (report.DecisionMakingScore < 80)
        {
            hasRecommendation =
                true;

            yield return
                "Prioritise safety-critical actions before secondary tasks.";
        }


        /*
         * Communication.
         */
        if (report.CommunicationScore < 90)
        {
            hasRecommendation =
                true;

            yield return
                "Declare the emergency and communicate intentions earlier.";
        }


        /*
         * Checklist usage.
         */
        if (report.ChecklistUsageScore < 90)
        {
            hasRecommendation =
                true;

            yield return
                "Increase checklist use after completing immediate memory actions.";
        }


        /*
         * Safety-critical errors.
         */
        if (report.SafetyCriticalErrors > 0)
        {
            hasRecommendation =
                true;

            yield return
                "Repeat the safety-critical memory actions before attempting the scenario again.";
        }


        /*
         * High standard.
         */
        if (!hasRecommendation)
        {
            yield return
                "Maintain the current standard and practise at a higher difficulty level.";
        }
    }


    /* =====================================================================
        PERFECT SCORE BADGE
       ===================================================================== */

    private bool HasPerfectScoreBadge =>
        _dashboard?.Achievements.Any(
            achievement =>
                string.Equals(
                    achievement.Code,
                    "perfect-score",
                    StringComparison.OrdinalIgnoreCase))
        == true;


    /* =====================================================================
        PDF DOWNLOAD
       ===================================================================== */

    private async Task DownloadReportAsync()
    {
        if (_dashboard?.Latest is null)
        {
            return;
        }


        var report =
            _dashboard.Latest;


        var pilotName =
            MakeFileNameSafe(
                report.PilotName);


        var scenarioName =
            MakeFileNameSafe(
                report.ScenarioName);


        var completedDate =
            report.CompletedAt
                .ToLocalTime()
                .ToString(
                    "yyyy-MM-dd");


        var fileName =
            $"AeroResponse-" +
            $"{pilotName}-" +
            $"{scenarioName}-" +
            $"{completedDate}.pdf";


        await JS.InvokeVoidAsync(
            "aeroReports.downloadPdf",
            "pilot-performance-report",
            fileName);
    }


    /* =====================================================================
        SAFE DOWNLOAD FILE NAME
       ===================================================================== */

    private static string MakeFileNameSafe(
        string value)
    {
        if (string.IsNullOrWhiteSpace(
                value))
        {
            return "Report";
        }


        foreach (
            var invalidCharacter in
                Path.GetInvalidFileNameChars())
        {
            value =
                value.Replace(
                    invalidCharacter,
                    '-');
        }


        return value
            .Replace(
                ' ',
                '-')
            .Trim('-');
    }


