@namespace AeroResponse.Components.Instruments.Rudder

<div class="cockpit-control rudder-control">

    <h3>Rudder</h3>

    <div class="rudder-display">
        <span>L</span>

        <input type="range"
               min="-1"
               max="1"
               step="0.05"
               value="@RudderPosition"
               @oninput="HandleRudderInput" />

        <span>R</span>
    </div>

    <p>
        @GetRudderDisplay()
    </p>

    <button type="button"
            @onclick="CenterRudder">
        Center
    </button>

</div>