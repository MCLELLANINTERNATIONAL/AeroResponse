@using System.Security.Claims
@using AeroResponse.Data.Mongo.Accounts
@using Microsoft.AspNetCore.Components.Authorization
@using MongoDB.Driver

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject MongoUserAccountRepository MongoUserAccounts
@inject ILogger<UserAccountEmblem> Logger

<a href="/user"
   class="user-emblem"
   title="@displayName"
   aria-label="Open profile">

    <span class="user-initials">
        @initials
    </span>

    <span class="user-name">
        @displayName
    </span>

</a>

@code
{
    private string displayName = "Account";
    private string initials = "A";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (!(user.Identity?.IsAuthenticated ?? false))
            return;

        displayName = GetFallbackName(user);
        initials = BuildInitials(displayName);

        var userId = user.FindFirstValue(ClaimTypes.NameIdentifier);

        if (string.IsNullOrWhiteSpace(userId))
            return;

        try
        {
            var account = await MongoUserAccounts.FindByIdentityUserIdAsync(userId);

            if (account != null)
            {
                var name = $"{account.FirstName} {account.Surname}".Trim();

                if (!string.IsNullOrWhiteSpace(name))
                {
                    displayName = name;
                    initials = BuildInitials(name);
                }
            }
        }
        catch
        {
            // Ignore database errors and keep fallback values.
        }
    }

    private static string GetFallbackName(ClaimsPrincipal user)
    {
        var name = user.Identity?.Name ?? "Account";

        if (name.Contains("@"))
            name = name.Split('@')[0];

        return name;
    }

    private static string BuildInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (parts.Length == 0)
            return "A";

        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();

        return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}