    private async Task DeleteSavedCardAsync()
    {
        if (isDeletingCard)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(identityUserId))
        {
            actionErrorMessage =
                "Your saved card could not be deleted.";

            return;
        }

        isDeletingCard = true;
        successMessage = null;
        actionErrorMessage = null;

        try
        {
            /*
             * This always deletes the signed-in user's
             * personal card. It never deletes a connected
             * company's card.
             */
            await SavedPaymentMethods
                .DeleteByIdentityUserIdAsync(
                    identityUserId);

            savedPaymentMethod =
                null;

            /*
             * For an account using its own membership,
             * its membership payment method is the same
             * card and must also be cleared.
             *
             * For a referred account, the company payment
             * method remains unchanged.
             */
            if (!UsesCompanyMembership)
            {
                membershipPaymentMethod =
                    null;
            }

            confirmCardDeletion =
                false;

            successMessage =
                "Your saved card has been deleted.";
        }
        catch (InvalidOperationException)
        {
            savedPaymentMethod =
                null;

            confirmCardDeletion =
                false;

            actionErrorMessage =
                "No saved card was found.";
        }
        catch (Exception exception)
        {
            Logger.LogError(
                exception,
                "Could not delete saved payment method " +
                "for user {UserId}.",
                identityUserId);

            actionErrorMessage =
                "Your saved card could not be deleted. " +
                "Please try again.";
        }
        finally
        {
            isDeletingCard =
                false;

            await InvokeAsync(
                StateHasChanged);
        }
    }



