@inject AuthenticationStateProvider AuthenticationStateProvider
@inject AccountPermissionService PermissionService
@inject NavigationManager NavigationManager

@implements IDisposable

<header class="site-header">
    <div class="nav-container">

        <NavLink class="brand"
                 href=""
                 Match="NavLinkMatch.All"
                 aria-label="AeroResponse home">

            <img src="/images/logo2.png"
                 alt="AeroResponse"
                 class="brand-logo" />
        </NavLink>

        <input id="nav-toggle"
               class="nav-toggle"
               type="checkbox"
               aria-label="Toggle navigation" />

        <label class="nav-toggle-label"
               for="nav-toggle"
               aria-hidden="true">

            <span></span>
            <span></span>
            <span></span>
        </label>

        <nav class="primary-nav"
             aria-label="Primary navigation">

            <NavLink href=""
                     Match="NavLinkMatch.All">
                Home
            </NavLink>

            <NavLink href="membership">
                Membership
            </NavLink>

            @if (_canUsePilotPages)
            {
                <NavLink href="reports">
                    Reports
                </NavLink>

                <NavLink href="simulation">
                    Simulation
                </NavLink>
            }

            @if (_canUseAdminPages)
            {
                <NavLink href="aircraft">
                    Aircraft
                </NavLink>

                <NavLink href="scenarios">
                    Scenarios
                </NavLink>
            }

        </nav>

        <div class="account-actions">

            <AuthorizeView>

                <Authorized>
                    <NavLink href="/user"
                             class="user-account-link">
                        <UserAccountEmblem />
                    </NavLink>

                    <form action="/Account/Logout"
                        method="post"
                        class="logout-action">
                        <AntiforgeryToken />
                        <button type="submit"
                                class="logout-button">
                            Log Out
                        </button>
                    </form>
                </Authorized>

                <NotAuthorized>
                    <a class="login-button"
                       href="/Account/Login">
                        Login
                    </a>

                    <a class="signup-button"
                       href="/Account/Register">
                        Sign Up
                    </a>
                </NotAuthorized>

            </AuthorizeView>

        </div>

    </div>
</header>

@code {
    private bool _canUsePilotPages;
    private bool _canUseAdminPages;

    protected override async Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged +=
            HandleLocationChanged;

        await LoadPermissionsAsync();
    }

    private async Task LoadPermissionsAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        _canUsePilotPages =
            await PermissionService
                .HasPermissionAsync(
                    authenticationState.User,
                    AccountPermissions.PilotPages);

        _canUseAdminPages =
            await PermissionService
                .HasPermissionAsync(
                    authenticationState.User,
                    AccountPermissions.AdminPages);
    }

    private async void HandleLocationChanged(
        object? sender,
        LocationChangedEventArgs e)
    {
        await InvokeAsync(
            async () =>
            {
                await LoadPermissionsAsync();
                StateHasChanged();
            });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -=
            HandleLocationChanged;
    }
}