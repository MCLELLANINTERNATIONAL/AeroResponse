@page "/scenarios/create"
@attribute [Authorize(Policy = AccountPermissions.AdminPages)]
@rendermode InteractiveServer

@using AeroResponse.Models
@using AeroResponse.Services

@inject ScenarioService ScenarioService
@inject NavigationManager NavigationManager
@inject SimulationEngine SimulationEngine

<PageTitle>Create Scenario | AeroResponse</PageTitle>

<section class="scenario-page scenario-form-page">

    <header class="scenario-header">
        <div>
            <span class="scenario-eyebrow">
                Scenario management
            </span>

            <h1>Create Emergency Scenario</h1>

            <p>
                Add a scenario that can be selected and run
                through the AeroResponse simulation engine.
            </p>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }

    <div class="scenario-form-card">

        <ScenarioForm
            Scenario="scenario"
            ProcedureSteps="procedureSteps"
            EmergencyTypes="emergencyTypes"
            FormName="create-scenario"
            SubmitText="Create scenario"
            IsSaving="isSaving"
            OnValidSubmit="CreateScenarioAsync" />

    </div>

</section>

@code {
    private readonly EmergencyScenario scenario = new()
    {
        Difficulty = "Beginner",
        TriggerType = "Immediate",
        TimeLimitSeconds = 120,
        IsActive = true,
        CreatedAt = DateTime.UtcNow
    };

    private readonly List<ScenarioProcedureStep> procedureSteps =
    [
        new()
        {
            AircraftType = "All",
            StepOrder = 1,
            Instruction = "Maintain aircraft control.",
            CorrectAction = "Maintain aircraft control.",
            IsSafetyCritical = true,
            MaxResponseSeconds = 10,
            ScoreWeight = 20,
            PerformanceCategory = "Procedure"
        }
    ];

    private List<string> emergencyTypes = [];

    private bool isSaving;
    private string? errorMessage;

    protected override void OnInitialized()
    {
        emergencyTypes = SimulationEngine
            .GetScenarios()
            .Select(s => s.ScenarioType)
            .OrderBy(s => s)
            .ToList();
    }

    private async Task CreateScenarioAsync()
    {
        if (isSaving)
        {
            return;
        }

        try
        {
            isSaving = true;
            errorMessage = null;

            scenario.CreatedAt = DateTime.UtcNow;

            await ScenarioService.CreateAsync(
                scenario,
                procedureSteps);

            NavigationManager.NavigateTo("/scenarios");
        }
        catch (Exception)
        {
            errorMessage =
                "The emergency scenario could not be created.";
        }
        finally
        {
            isSaving = false;
        }
    }
}