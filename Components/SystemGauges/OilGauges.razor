<svg viewBox="0 0 420 240" class="oil-dual-gauge">
    <rect x="14" y="14" width="392" height="212" rx="18" class="oil-gauge-case" />
    <rect x="26" y="26" width="368" height="188" rx="14" class="oil-gauge-face" />

    <g transform="translate(120 120)">
        <circle cx="0" cy="0" r="78" class="oil-dial" />
        <path d="M -58 42 A 70 70 0 0 1 58 42" class="oil-green-arc" />
        <line x1="0" y1="0" x2="0" y2="-58" class="oil-needle pressure" transform="@PressureNeedleTransform" />
        <circle cx="0" cy="0" r="8" class="oil-hub" />
        <text x="0" y="94" text-anchor="middle" class="oil-value">@OilPressure.ToString("N0") PSI</text>
        <text x="0" y="-92" text-anchor="middle" class="oil-label">OIL PRESS</text>
    </g>

    <g transform="translate(300 120)">
        <circle cx="0" cy="0" r="78" class="oil-dial" />
        <path d="M -58 42 A 70 70 0 0 1 58 42" class="oil-green-arc" />
        <line x1="0" y1="0" x2="0" y2="-58" class="oil-needle temperature" transform="@TemperatureNeedleTransform" />
        <circle cx="0" cy="0" r="8" class="oil-hub" />
        <text x="0" y="94" text-anchor="middle" class="oil-value">@OilTemperature.ToString("N0") °F</text>
        <text x="0" y="-92" text-anchor="middle" class="oil-label">OIL TEMP</text>
    </g>
</svg>

@code {
    [Parameter] public double OilPressure { get; set; }
    [Parameter] public double OilTemperature { get; set; }

    private string PressureNeedleTransform
    {
        get
        {
            var clamped = Math.Clamp(OilPressure, 0, 100);
            var angle = -120 + (clamped / 100.0) * 240;
            return $"rotate({angle})";
        }
    }

    private string TemperatureNeedleTransform
    {
        get
        {
            var clamped = Math.Clamp(OilTemperature, 0, 250);
            var angle = -120 + (clamped / 250.0) * 240;
            return $"rotate({angle})";
        }
    }
}