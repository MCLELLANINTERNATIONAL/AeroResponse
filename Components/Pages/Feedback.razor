@page "/reports/feedback"
@attribute [Authorize(Policy = AccountPermissions.PilotPages)]
@rendermode InteractiveServer
@implements IDisposable

@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject PerformanceDashboardService DashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject PilotReportAccessService PilotReportAccess

<PageTitle>Feedback | AeroResponse</PageTitle>

@if (_loading)
{
    <div class="reports-loading">
        Loading feedback…
    </div>
}
else if (_dashboard?.Latest is null)
{
    <div class="reports-empty">

        <h1>
            No feedback available yet
        </h1>

        <p>
            Complete a practice scenario to receive performance feedback.
        </p>

        <PilotReportSelector />

    </div>
}
else
{
    var report = _dashboard.Latest;

    <main class="reports-page">

        <header class="reports-header">

            <div>

                <h1>
                    PERFORMANCE FEEDBACK
                </h1>

                <p>
                    Review instructor and AI-generated recommendations
                </p>

            </div>

            <PilotReportSelector />

        </header>


        <nav class="reports-tabs">

            <NavLink
            href="@PilotReportHref("/reports")"
            Match="NavLinkMatch.All">
            ◉ Overview
        </NavLink>

        <NavLink href="@PilotReportHref("/reports/flight-logs")">
            ✈ Flight Logs
        </NavLink>

        <NavLink href="@PilotReportHref("/reports/scoring")">
            ⚙ Scoring
        </NavLink>

        <NavLink href="@PilotReportHref("/reports/analytics")">
            ▥ Analytics
        </NavLink>

        <NavLink href="@PilotReportHref("/reports/feedback")">
            ✪ Feedback
        </NavLink>

        <NavLink href="@PilotReportHref("/reports/badges")">
            🏆 Badges
        </NavLink>
        <AuthorizeView Policy="@AccountPermissions.TrainerReports">
            <Authorized>
                <NavLink href="/reports/instructor">
                    👨‍✈ Instructor Reports
                </NavLink>
            </Authorized>
        </AuthorizeView>
        <AuthorizeView Policy="@AccountPermissions.AdminPages">
            <Authorized>
                <NavLink href="/reports/admin">
                    ▦ Admin Reports
                </NavLink>
            </Authorized>
        </AuthorizeView>

    </nav>


    <section class="reports-grid">

        <!-- =========================================================
        FEEDBACK
        ========================================================= -->

        <article class="report-card feedback-card">

            <h2>
                Feedback
            </h2>


            <!-- =====================================================
            FEEDBACK TABS
            ===================================================== -->

            <div
            class="feedback-tabs"
            role="tablist"
            aria-label="Feedback type">

            <button
            type="button"
            role="tab"
            aria-selected="@(_activeFeedbackTab == FeedbackTab.Instructor)"
            class="@GetFeedbackTabClass(FeedbackTab.Instructor)"
            @onclick="() => SelectFeedbackTab(FeedbackTab.Instructor)">

            Instructor Feedback

        </button>


        <button
        type="button"
        role="tab"
        aria-selected="@(_activeFeedbackTab == FeedbackTab.Ai)"
        class="@GetFeedbackTabClass(FeedbackTab.Ai)"
        @onclick="() => SelectFeedbackTab(FeedbackTab.Ai)">

        AI Feedback

    </button>

</div>


<!-- =====================================================
INSTRUCTOR FEEDBACK
===================================================== -->

@if (_activeFeedbackTab == FeedbackTab.Instructor)
{
    <div class="feedback-good">

        <strong>
            @GetInstructorHeading(report)
        </strong>

        @if (string.IsNullOrWhiteSpace(report.Feedback))
        {
            <p>
                No instructor feedback is available
                for this assessment.
            </p>
        }
        else
        {
            <p>
                @report.Feedback
            </p>
        }

    </div>


    <h3>
        Areas to Improve
    </h3>


    <ul>

        @foreach (var item in ImprovementItems(report))
        {
            <li>
                @item
            </li>
        }

    </ul>
}


<!-- =====================================================
AI FEEDBACK
===================================================== -->

@if (_activeFeedbackTab == FeedbackTab.Ai)
{
    <div class="feedback-ai">

        <h3>
            AI Performance Analysis
        </h3>

        @if (string.IsNullOrWhiteSpace(report.AiFeedback))
        {
            <p>
                No AI-generated analysis is available
                for this assessment.
            </p>
        }
        else
        {
            <p>
                @report.AiFeedback
            </p>
        }

    </div>


    <h3>
        AI Recommended Focus
    </h3>


    <ul>

        @foreach (var item in AiImprovementItems(report))
        {
            <li>
                @item
            </li>
        }

    </ul>
}

</article>


<!-- =========================================================
CURRENT SCENARIO
========================================================= -->

<article class="report-card scenario-summary">

    <h2>
        Current Scenario
    </h2>


    <div class="scenario-title">

        <span>
            ✈
        </span>


        <div>

            <strong>
                @report.ScenarioName
            </strong>


            <small>
                Completed:
                @(report.CompletedAt
                .ToLocalTime()
                .ToString("dd MMM yyyy 'at' HH:mm"))
            </small>


            <small>
                Difficulty:
                @report.Difficulty
            </small>

        </div>


        <b>
            EMERGENCY
        </b>

    </div>


    <hr />


    <!-- REACTION TIME -->

    <div class="info-row">

        <span>
            ◷
        </span>

        <label>
            Reaction Time
        </label>

        <strong>
            @report.ReactionTimeSeconds seconds
        </strong>

    </div>


    <!-- ACTIONS TAKEN -->

    <div class="info-row">

        <span>
            ☑
        </span>

        <label>
            Actions Taken
        </label>

        <strong>
            @report.ActionsTaken
        </strong>

    </div>


    <!-- SAFETY CRITICAL ERRORS -->

    <div class="info-row">

        <span>
            ⚠
        </span>

        <label>
            Safety-Critical Errors
        </label>

        <strong>
            @report.SafetyCriticalErrors
        </strong>

    </div>


    <!-- PROCEDURAL ACCURACY -->

    <div class="info-row">

        <span>
            ▣
        </span>

        <label>
            Procedural Accuracy
        </label>

        <strong>
            @report.ProcedureAccuracyScore%
        </strong>

    </div>


    <!-- CHECKLIST USAGE -->

    <div class="info-row">

        <span>
            ☑
        </span>

        <label>
            Checklist Usage
        </label>

        <strong>
            @report.ChecklistUsageScore%
        </strong>

    </div>


    <!-- RESULT -->

    <div class="info-row">

        <span>
            🏁
        </span>

        <label>
            Result
        </label>

        <strong>
            @(report.Passed
            ? "Passed"
            : "Review Required")
        </strong>

    </div>

</article>

</section>


<p class="live-note">
    ● Instructor and AI feedback update automatically when a pilot
    completes a scenario.
</p>

</main>
}

@code {

    [SupplyParameterFromQuery(Name = "pilotUserId")]
    public string? PilotUserId { get; set; }

    /*
     * =====================================================================
     * CURRENT PILOT
     *
     * Authentication is not yet fully implemented.
     *
     * Use the authenticated ASP.NET Identity UserId when available.
     *
     * Otherwise use debug-pilot during development so Simulation,
     * Overview, Flight Logs, Scoring, Analytics, Feedback and Badges
     * all query the same pilot history.
     * =====================================================================
     */

    private string _currentUserId =
        string.Empty;


    /*
     * =====================================================================
     * PAGE STATE
     * =====================================================================
     */

    private PerformanceDashboardVm? _dashboard;

    private bool _loading = true;


    /*
     * =====================================================================
     * ACTIVE FEEDBACK TAB
     * =====================================================================
     */

    private FeedbackTab _activeFeedbackTab =
        FeedbackTab.Instructor;


    /*
     * =====================================================================
     * INITIALIZATION
     * =====================================================================
     */

    protected override async Task OnInitializedAsync()
    {
        var authenticationState =
            await AuthenticationStateProvider
                .GetAuthenticationStateAsync();

        var principal =
            authenticationState.User;


        /*
         * Use the real authenticated Identity UserId when available.
         *
         * Until authentication is complete, use debug-pilot so the
         * Feedback page reads the same pilot used by Simulation and
         * the other reporting pages.
         */
        _currentUserId =
            await PilotReportAccess.ResolvePilotUserIdAsync(
                principal,
                PilotUserId)
            ?? string.Empty;


        /*
         * Listen for newly completed reports.
         */
        PerformanceFeed.ReportSaved +=
            OnReportSaved;


        /*
         * Load the latest report for this pilot.
         */
        await LoadAsync();
    }


    /*
     * =====================================================================
     * FEEDBACK TAB SELECTION
     * =====================================================================
     */

    private void SelectFeedbackTab(
        FeedbackTab tab)
    {
        _activeFeedbackTab =
            tab;
    }


    private string GetFeedbackTabClass(
        FeedbackTab tab)
    {
        return _activeFeedbackTab == tab
            ? "feedback-tab-button active"
            : "feedback-tab-button";
    }


    /*
     * =====================================================================
     * INSTRUCTOR FEEDBACK HEADING
     * =====================================================================
     */

    private static string GetInstructorHeading(
        SimulationReport report)
    {
        /*
         * No response or an actual failed simulation always requires
         * review regardless of numerical score.
         */
        if (report.ActionsTaken == 0 ||
            !report.Passed)
        {
            return "Review Required";
        }


        return report.OverallScore >= 85
            ? "☆ Great Job!"
            : "Good Attempt";
    }


    /*
     * =====================================================================
     * LIVE REPORT UPDATE
     * =====================================================================
     */

    private async void OnReportSaved(
        string userId)
    {
        /*
         * Ignore simulation reports belonging to another pilot.
         */
        if (!string.Equals(
                userId,
                _currentUserId,
                StringComparison.Ordinal))
        {
            return;
        }


        /*
         * Reload both Instructor and AI feedback from the same newest
         * SimulationReport.
         */
        await InvokeAsync(
            async () =>
            {
                await LoadAsync();

                StateHasChanged();
            });
    }


    /*
     * =====================================================================
     * LOAD DASHBOARD DATA
     * =====================================================================
     */

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;


            _dashboard =
                await DashboardService
                    .GetDashboardAsync(
                        _currentUserId);
        }
        finally
        {
            _loading = false;
        }
    }


    /*
     * =====================================================================
     * INSTRUCTOR IMPROVEMENT ITEMS
     *
     * These recommendations are generated from the same latest
     * SimulationReport shown throughout the Feedback page.
     * =====================================================================
     */

    private static IEnumerable<string>
        ImprovementItems(
            SimulationReport report)
    {
        var hasImprovementItem =
            false;


        /*
         * No pilot response.
         */
        if (report.ActionsTaken == 0)
        {
            hasImprovementItem =
                true;

            yield return
                "Begin the response immediately after the warning appears.";
        }


        /*
         * Reaction time.
         */
        if (report.ReactionTimeSeconds > 10)
        {
            hasImprovementItem =
                true;

            yield return
                $"Improve time to identify the primary failure " +
                $"({report.ReactionTimeSeconds - 10}s slower than target).";
        }


        /*
         * Procedural accuracy.
         */
        if (report.ProcedureAccuracyScore < 95)
        {
            hasImprovementItem =
                true;

            yield return
                "Review the emergency procedure and maintain the correct action sequence.";
        }


        /*
         * Checklist usage.
         */
        if (report.ChecklistUsageScore < 90)
        {
            hasImprovementItem =
                true;

            yield return
                "Use the emergency checklist consistently once immediate memory actions are complete.";
        }


        /*
         * Communication.
         */
        if (report.CommunicationScore < 90)
        {
            hasImprovementItem =
                true;

            yield return
                "Consider declaring the emergency and communicating intentions earlier.";
        }


        /*
         * Decision making.
         */
        if (report.DecisionMakingScore < 85)
        {
            hasImprovementItem =
                true;

            yield return
                "Prioritise safety-critical actions before secondary cockpit tasks.";
        }


        /*
         * Safety-critical errors.
         */
        if (report.SafetyCriticalErrors > 0)
        {
            hasImprovementItem =
                true;

            yield return
                "Review safety-critical actions before the next attempt.";
        }


        /*
         * Strong performance.
         */
        if (!hasImprovementItem)
        {
            yield return
                "Continue maintaining the same high standard in future scenarios.";
        }
    }


    /*
     * =====================================================================
     * AI RECOMMENDED FOCUS
     *
     * These recommendations complement report.AiFeedback.
     * =====================================================================
     */

    private static IEnumerable<string>
        AiImprovementItems(
            SimulationReport report)
    {
        var hasRecommendation =
            false;


        /*
         * No initial response.
         */
        if (report.ActionsTaken == 0)
        {
            hasRecommendation =
                true;

            yield return
                "Practise recognizing the initial warning and beginning the first memory action immediately.";
        }


        /*
         * Procedure.
         */
        if (report.ProcedureAccuracyScore < 85)
        {
            hasRecommendation =
                true;

            yield return
                "Review the gold-standard procedure and practise the exact action sequence.";
        }


        /*
         * Time management.
         */
        if (report.TimeManagementScore < 80)
        {
            hasRecommendation =
                true;

            yield return
                "Reduce the delay between the warning and the first cockpit action.";
        }


        /*
         * Decision making.
         */
        if (report.DecisionMakingScore < 80)
        {
            hasRecommendation =
                true;

            yield return
                "Prioritise safety-critical actions before secondary tasks.";
        }


        /*
         * Communication.
         */
        if (report.CommunicationScore < 90)
        {
            hasRecommendation =
                true;

            yield return
                "Declare the emergency and communicate intentions earlier.";
        }


        /*
         * Checklist usage.
         */
        if (report.ChecklistUsageScore < 90)
        {
            hasRecommendation =
                true;

            yield return
                "Increase checklist use after completing immediate memory actions.";
        }


        /*
         * Safety-critical errors.
         */
        if (report.SafetyCriticalErrors > 0)
        {
            hasRecommendation =
                true;

            yield return
                "Focus the next practice attempt on eliminating safety-critical procedural errors.";
        }


        /*
         * High performance.
         */
        if (!hasRecommendation)
        {
            yield return
                "Maintain the current standard and practise under a higher difficulty level.";
        }
    }


    /*
     * =====================================================================
     * CLEANUP
     * =====================================================================
     */

    public void Dispose()
    {
        PerformanceFeed.ReportSaved -=
            OnReportSaved;
    }


    /*
     * =====================================================================
     * FEEDBACK TAB TYPES
     * =====================================================================
     */

    private enum FeedbackTab
    {
        Instructor,
        Ai
    }


    private string PilotReportHref(string path)
    {
        return string.IsNullOrWhiteSpace(PilotUserId)
            ? path
            : $"{path}?pilotUserId={Uri.EscapeDataString(PilotUserId)}";
    }
}