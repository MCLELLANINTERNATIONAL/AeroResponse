@page "/reports/scoring"
@rendermode InteractiveServer
@implements IDisposable

@inject PerformanceDashboardService DashboardService

<PageTitle>Scoring | AeroResponse</PageTitle>

@if (_loading)
{
    <div class="reports-loading">
        Loading scoring information…
    </div>
}
else if (_dashboard?.Latest is null)
{
    <div class="reports-empty">
        <h1>No scoring information yet</h1>
        <p>Complete a practice scenario to view your scoring results.</p>
    </div>
}
else
{
    var report = _dashboard.Latest;

    <main class="reports-page">

        <header class="reports-header">
            <div>
                <h1>SCORING</h1>
                <p>Review your overall score and performance breakdown</p>
            </div>

            <div class="pilot-chip">
                <span class="pilot-avatar">✈</span>

                <div>
                    <strong>@report.PilotName</strong>
                    <small>Professional Pilot</small>
                </div>
            </div>
        </header>

        <nav class="reports-tabs">
            <NavLink href="/reports" Match="NavLinkMatch.All">
                ◉ Overview
            </NavLink>

            <NavLink href="/reports/flight-logs">
                ✈ Flight Logs
            </NavLink>

            <NavLink href="/reports/scoring">
                ⚙ Scoring
            </NavLink>

            <NavLink href="/reports/analytics">
                ▥ Analytics
            </NavLink>

            <NavLink href="/reports/feedback">
                ✪ Feedback
            </NavLink>

            <NavLink href="/reports/badges">
                🏆 Badges
            </NavLink>

            <NavLink href="/reports/instructor">
                👨‍✈ Instructor Reports
            </NavLink>

            <NavLink href="/reports/admin">
                ▦ Admin Reports
            </NavLink>
        </nav>

        <section class="reports-grid top-grid">

            <article class="report-card score-card">
                <h2>Overall Score</h2>

                <div class="score-main">

                    <div class="score-ring"
                    style="--score:@report.OverallScore">

                    <span>@report.OverallScore%</span>

                    <small>
                        @(report.OverallScore >= 70
                        ? "Great Performance!"
                        : "Keep Practising")
                    </small>
                </div>

                <div class="score-copy">
                    <small>Total Score</small>
                    <strong>@(report.OverallScore * 10) / 1000</strong>

                    <small>Passing Score</small>
                    <b>70% (700/1000)</b>

                    <small>Rank</small>
                    <strong>Top @RankPercent%</strong>
                    <em>of all users</em>
                </div>
            </div>

            <div class="pass-banner">
                🏆

                <span>
                    <strong>
                        @(report.OverallScore >= 70
                        ? "You passed this scenario!"
                        : "Scenario not yet passed")
                    </strong>

                    <small>
                        @(report.OverallScore >= 70
                        ? "Keep up the great work."
                        : "Review feedback and try again.")
                    </small>
                </span>
            </div>
        </article>

        <article class="report-card">
            <h2>Score Breakdown</h2>

            <div class="metric">
                <div class="metric-result">
                    <span>Procedural Accuracy</span>
                    <strong>@report.ChecklistAccuracyScore%</strong>
                </div>

                <div class="metric-track">
                    <div class="metric-fill blue"
                    style="width: @report.ChecklistAccuracyScore%;">
                </div>
            </div>
        </div>

        <div class="metric">
            <div class="metric-result">
                <span>Decision Making</span>
                <strong>@report.DecisionMakingScore%</strong>
            </div>

            <div class="metric-track">
                <div class="metric-fill green"
                style="width: @report.DecisionMakingScore%;">
            </div>
        </div>
    </div>

    <div class="metric">
        <div class="metric-result">
            <span>Checklist Usage</span>
            <strong>@report.ChecklistUsageScore%</strong>
        </div>

        <div class="metric-track">
            <div class="metric-fill orange"
            style="width: @report.ChecklistUsageScore%;">
        </div>
    </div>
</div>

<div class="metric">
    <div class="metric-result">
        <span>Time Management</span>
        <strong>@report.TimeManagementScore%</strong>
    </div>

    <div class="metric-track">
        <div class="metric-fill purple"
        style="width: @report.TimeManagementScore%;">
    </div>
</div>
</div>

<div class="metric">
    <div class="metric-result">
        <span>Communication</span>
        <strong>@report.CommunicationScore%</strong>
    </div>

    <div class="metric-track">
        <div class="metric-fill cyan"
        style="width: @report.CommunicationScore%;">
    </div>
</div>
</div>
</article>

<article class="report-card scenario-summary">
    <h2>Current Scenario</h2>

    <div class="scenario-title">
        <span>✈</span>

        <div>
            <strong>@report.ScenarioName</strong>

            <small>
                Completed:
                @report.CompletedAt
                .ToLocalTime()
                .ToString("dd MMM yyyy 'at' HH:mm")
            </small>

            <small>
                Difficulty: @report.Difficulty
            </small>
        </div>

        <b>EMERGENCY</b>
    </div>

    <hr />

    <div class="info-row">
        <span>◷</span>
        <label>Reaction Time</label>
        <strong>@report.ReactionTimeSeconds seconds</strong>
    </div>

    <div class="info-row">
        <span>☑</span>
        <label>Actions Taken</label>
        <strong>@report.ActionsTaken</strong>
    </div>

    <div class="info-row">
        <span>▣</span>
        <label>Checklist Used</label>
        <strong>@report.ChecklistUsageScore%</strong>
    </div>
</article>

</section>

<p class="live-note">
    ● Live scoring information updates automatically when a pilot
    completes a practice scenario.
</p>

</main>
}

@code {
    private const string UserId = "test-pilot";

    private PerformanceDashboardVm? _dashboard;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        PerformanceFeed.ReportSaved += OnReportSaved;
        await LoadAsync();
    }

    private async void OnReportSaved(string userId)
    {
        if (userId != UserId)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await LoadAsync();
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;
            _dashboard = await DashboardService.GetDashboardAsync(UserId);
        }
        finally
        {
            _loading = false;
        }
    }

    private int RankPercent =>
        Math.Max(
            1,
            100 - (_dashboard?.Latest?.OverallScore ?? 0));

    public void Dispose()
    {
        PerformanceFeed.ReportSaved -= OnReportSaved;
    }
}