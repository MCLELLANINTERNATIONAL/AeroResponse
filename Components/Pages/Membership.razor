@page "/membership"
@rendermode InteractiveServer

<PageTitle>Membership | AeroResponse</PageTitle>

<div class="membership-page">
    <aside class="membership-sidebar" aria-label="Membership benefits">
        <div class="sidebar-aircraft"
             role="img"
             aria-label="Passenger aircraft on a runway">
        </div>

        <div class="sidebar-content">
            <h2>All Plans Include</h2>

            <div class="benefit-list">
                @foreach (var benefit in Benefits)
                {
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="@benefit.Icon" aria-hidden="true"></i>
                        </div>

                        <div>
                            <h3>@benefit.Title</h3>
                            <p>@benefit.Description</p>
                        </div>
                    </div>
                }
            </div>

            <a class="help-card" href="mailto:support@aeroresponse.com">
                <i class="fa-solid fa-headset" aria-hidden="true"></i>

                <span>
                    <strong>Need help choosing?</strong>
                    <small>Contact our team</small>
                </span>

                <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
            </a>
        </div>
    </aside>

    <main class="membership-main">
        <header class="membership-heading">
            <h1>Choose Your Plan</h1>

            <p>
                Flexible membership options for private pilots,
                aviation businesses and large commercial operators.
            </p>

            <div class="billing-toggle"
                 role="group"
                 aria-label="Billing frequency">

                <button class="@(!IsAnnual ? "active" : null)"
                        type="button"
                        aria-pressed="@(!IsAnnual)"
                        @onclick="() => IsAnnual = false">
                    Monthly Billing
                </button>

                <button class="@(IsAnnual ? "active" : null)"
                        type="button"
                        aria-pressed="@IsAnnual"
                        @onclick="() => IsAnnual = true">
                    Annual Billing
                    <span>Save 20%</span>
                </button>
            </div>
        </header>

        <section class="plan-grid" aria-label="Membership plans">
            @foreach (var plan in Plans)
            {
                <article class="plan-card @(plan.Featured ? "featured" : null) @plan.AccentClass">
                    @if (plan.Featured)
                    {
                        <div class="popular-badge">Most Popular</div>
                    }

                    <div class="plan-icon">
                        <i class="@plan.Icon" aria-hidden="true"></i>
                    </div>

                    <h2>@plan.Name</h2>

                    <p class="plan-summary">@plan.Summary</p>

                    <div class="price-row">
                        <span class="currency">$</span>
                        <span class="price">@GetPrice(plan)</span>
                        <span class="period">/month</span>
                    </div>

                    <p class="billing-note">
                        @(IsAnnual ? "Billed annually" : "Billed monthly")
                    </p>

                    <div class="plan-divider"></div>

                    <ul>
                        @foreach (var feature in plan.Features)
                        {
                            <li>
                                <i class="fa-solid fa-circle-check"
                                   aria-hidden="true"></i>

                                <span>@feature</span>
                            </li>
                        }
                    </ul>

                    <a class="plan-button" href="@GetCheckoutLink(plan)">
                        @plan.ButtonText
                    </a>
                </article>
            }
        </section>

        <section class="trust-strip" aria-label="Membership assurances">
            <div>
                <i class="fa-solid fa-shield-halved"
                   aria-hidden="true"></i>

                <span>
                    <strong>Secure &amp; Trusted</strong>
                    <small>Your data is encrypted and secure</small>
                </span>
            </div>

            <div>
                <i class="fa-solid fa-arrows-rotate"
                   aria-hidden="true"></i>

                <span>
                    <strong>Cancel Anytime</strong>
                    <small>No long-term contracts. Ever.</small>
                </span>
            </div>

            <div>
                <i class="fa-solid fa-award"
                   aria-hidden="true"></i>

                <span>
                    <strong>Money Back Guarantee</strong>
                    <small>30-day money back guarantee</small>
                </span>
            </div>
        </section>
    </main>
</div>

@code {
    private bool IsAnnual;

    private decimal GetPrice(Plan plan)
    {
        return IsAnnual
            ? Math.Round(plan.MonthlyPrice * 0.8m, 0)
            : plan.MonthlyPrice;
    }

    private string GetCheckoutLink(Plan plan)
    {
        var encodedPlanName = Uri.EscapeDataString(plan.Name);
        var billing = IsAnnual ? "annual" : "monthly";

        return $"/checkout?plan={encodedPlanName}&billing={billing}";
    }

    private static readonly Benefit[] Benefits =
    [
        new(
            "fa-solid fa-shield",
