    private static readonly Plan[] Plans =
    [
        new(
            Name: "Private",
            Summary: "Personal emergency training for private pilots.",
            MonthlyPrice: 99m,
            Icon: "fa-regular fa-paper-plane",
            AccentClass: "private-plan",
            Features:
            [
                "10 Training Scenarios per Month",
                "General Aviation Aircraft Access",
                "Personal Performance Tracking",
                "Interactive Emergency Checklists",
                "Training History & Progress Reports",
                "Certificates of Completion",
                "Email Support",
                "Mobile & Web Access"
            ],
            ButtonText: "Start Private Plan",
            Link: "/signup",
            Featured: false
        ),
        new(
