@page "/reports/instructor"
@rendermode InteractiveServer

@* ============================================================
    TEMPORARILY DISABLED WHILE DEVELOPING THE DASHBOARD.

    FINAL VERSION:
    Uncomment @attribute [Authorize]
    and set DevelopmentPreviewMode = false below.
   ============================================================ *@

@* @attribute [Authorize] *@

@using System.IO
@using System.Security.Claims
@using AeroResponse.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@inject InstructorDashboardService InstructorDashboardService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>
    Instructor Pilots Results Dashboard | AeroResponse
</PageTitle>

@if (_loading)
{
    <main class="reports-page instructor-dashboard-page">

        <div class="reports-loading">

            <div class="loading-spinner"></div>

            <strong>
                Loading Instructor Dashboard...
            </strong>

            <span>
                Preparing pilot performance data
            </span>

        </div>

    </main>
}
else if (_dashboard is null)
{
    <main class="reports-page instructor-dashboard-page">

        <div class="reports-empty">

            <div class="empty-icon">
                ⚠
            </div>

            <h1>
                Instructor Dashboard unavailable
            </h1>

            <p>
                The training dashboard could not be loaded.
            </p>

        </div>

    </main>
}
else if (!_dashboard.IsAuthorised)
{
    <main class="reports-page instructor-dashboard-page">

        <div class="reports-empty">

            <div class="empty-icon">
                👨‍✈
            </div>

            <h1>
                Instructor Reports
            </h1>

            <p>
                This dashboard is available to instructors
                and company training administrators.
            </p>

        </div>

    </main>
}
else
{
    <main id="instructor-performance-report"
        class="reports-page instructor-dashboard-page">

        @* =====================================================
            HEADER
           ===================================================== *@

        <header class="reports-header">

            <div class="reports-heading">

                <span class="reports-eyebrow">
                    AERORESPONSE TRAINING ANALYTICS
                </span>

                <h1>
                    INSTRUCTOR PILOTS RESULTS DASHBOARD
                </h1>

                <p>
                    Monitor pilot performance trends,
                    scenario outcomes and training priorities
                    at both individual and organisational level.
                </p>

            </div>

            <div class="instructor-chip">

                <span class="instructor-avatar">
                    👨‍✈
                </span>

                <div>

                    <strong>
                        Instructor View
                    </strong>

                    <small>
                        @CurrentScopeLabel
                    </small>

                </div>

            </div>

        </header>


        @* =====================================================
            NAVIGATION
           ===================================================== *@

        <nav class="reports-tabs"
            aria-label="Performance report navigation">

            <NavLink href="/reports"
                     Match="NavLinkMatch.All">
                <span>◉</span>
                Overview
            </NavLink>

            <NavLink href="/reports/flight-logs">
                <span>✈</span>
                Flight Logs
            </NavLink>

            <NavLink href="/reports/scoring">
                <span>⚙</span>
                Scoring
            </NavLink>

            <NavLink href="/reports/analytics">
                <span>▥</span>
                Analytics
            </NavLink>

            <NavLink href="/reports/feedback">
                <span>✪</span>
                Feedback
            </NavLink>

            <NavLink href="/reports/badges">
                <span>🏆</span>
                Badges
            </NavLink>

            <NavLink href="/reports/instructor">
                <span>👨‍✈</span>
                Instructor Reports
            </NavLink>

            <NavLink href="/reports/admin">
                <span>▦</span>
                Admin Reports
            </NavLink>

            <button id="download-instructor-report-button"
                    class="download-report-button"
                    type="button"
                    @onclick="DownloadReportAsync">

                <span>⬇</span>
                Download PDF

            </button>

        </nav>


        @if (_dashboard.IsDevelopmentPreview)
        {
            <section class="development-notice">

                <span class="development-notice-icon">
                    ⚙
                </span>

                <div>

                    <strong>
                        Development Preview
                    </strong>

                    <span>
                        Authentication is temporarily bypassed.
                        Preview data includes all available simulation reports.
                    </span>

                </div>

            </section>
        }


        @* =====================================================
            FILTERS
           ===================================================== *@

        <section class="dashboard-filter-card">

            <div class="filter-heading">

                <span class="filter-icon">
                    ▥
                </span>

                <div>

                    <strong>
                        Training Performance
                    </strong>

                    <small>
                        @PeriodDescription
                    </small>

                </div>

            </div>

            <div class="filter-controls">

                <label class="filter-control">

                    <span>
                        Pilot
                    </span>

                    <select value="@(_selectedPilotUserId ?? string.Empty)"
                            @onchange="ChangePilotAsync">

                        <option value="">
                            All Pilots
                        </option>

                        @foreach (var pilot in _dashboard.Pilots)
                        {
                            <option value="@pilot.UserId">
                                @pilot.Name
                            </option>
                        }

                    </select>

                </label>

                <label class="filter-control">

                    <span>
                        Reporting Period
                    </span>

                    <select value="@_selectedDays"
                            @onchange="ChangePeriodAsync">

                        <option value="7">
                            Last 7 days
                        </option>

                        <option value="30">
                            Last 30 days
                        </option>

                        <option value="90">
                            Last 90 days
                        </option>

                        <option value="0">
                            All time
                        </option>

                    </select>

                </label>

            </div>

        </section>


        @* =====================================================
            KPI SUMMARY
           ===================================================== *@

        <section class="kpi-grid"
                aria-label="Instructor training summary">

            <article class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-icon">
                        👥
                    </span>

                    <span class="kpi-label">
                        Linked Pilots
                    </span>

                </div>

                <strong class="kpi-value">
                    @_dashboard.TotalPilots
                </strong>

                <small>
                    @_dashboard.ActivePilots active in
                    selected results
                </small>

            </article>


            <article class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-icon">
                        ✈
                    </span>

                    <span class="kpi-label">
                        Training Attempts
                    </span>

                </div>

                <strong class="kpi-value">
                    @_dashboard.TotalAttempts
                </strong>

                <small>
                    Completed simulations
                </small>

            </article>


            <article class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-icon">
                        ★
                    </span>

                    <span class="kpi-label">
                        Average Score
                    </span>

                </div>

                <strong class="kpi-value">
                    @($"{_dashboard.AverageScore}%")
                </strong>

                <small>
                    Across selected training
                </small>

            </article>


            <article class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-icon">
                        ✓
                    </span>

                    <span class="kpi-label">
                        Pass Rate
                    </span>

                </div>

                <strong class="kpi-value">
                    @($"{_dashboard.PassRate}%")
                </strong>

                <small>
                    @_dashboard.PassCount passed ·
                    @_dashboard.FailCount failed
                </small>

            </article>


            <article class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-icon">
                        ⏱
                    </span>

                    <span class="kpi-label">
                        Avg. Reaction
                    </span>

                </div>

                <strong class="kpi-value">
                    @_dashboard.AverageReactionTime s
                </strong>

                <small>
                    Emergency response time
                </small>

            </article>


            <article class="kpi-card">

                <div class="kpi-top">

                    <span class="kpi-icon warning">
                        ⚠
                    </span>

                    <span class="kpi-label">
                        Critical Errors
                    </span>

                </div>

                <strong class="kpi-value">
                    @_dashboard.SafetyCriticalErrors
                </strong>

                <small>
                    Safety-critical mistakes
                </small>

            </article>

        </section>


        @* =====================================================
            PERFORMANCE TREND + OUTCOMES
           ===================================================== *@

        <section class="dashboard-primary-grid">

            <article class="dashboard-card trend-card">

                <div class="card-heading">

                    <div>

                        <span class="card-eyebrow">
                            PERFORMANCE
                        </span>

                        <h2>
                            Pilot Performance Trend
                        </h2>

                    </div>

                    <span class="card-stat">
                        @_dashboard.TotalAttempts attempts
                    </span>

                </div>

                @if (_dashboard.PerformanceTrend.Count == 0)
                {
                    <div class="no-data">

                        <span>
                            ▥
                        </span>

                        <strong>
                            No performance data
                        </strong>

                        <small>
                            Complete pilot simulations to
                            generate performance trends.
                        </small>

                    </div>
                }
                else
                {
                    <div class="usage-chart"
                        aria-label="Pilot performance trend">

                        @foreach (var day in _dashboard.PerformanceTrend)
                        {
                            var height =
                                Math.Clamp(
                                    day.AverageScore,
                                    8,
                                    100);

                            <div class="usage-column"
                                 title="@($"{day.Date:dd MMM}: {day.AverageScore}% average score from {day.Attempts} attempt(s)")">

                                <strong>
                                    @($"{day.AverageScore}%")
                                </strong>

                                <div class="usage-bar-track">

                                    <div class="usage-bar"
                                         style="@($"height:{height}%")">
                                    </div>

                                </div>

                                <small>
                                    @day.Date.ToString("dd MMM")
                                </small>

                            </div>
                        }

                    </div>
                }

            </article>


            <article class="dashboard-card outcomes-card">

                <div class="card-heading">

                    <div>

                        <span class="card-eyebrow">
                            OUTCOMES
                        </span>

                        <h2>
                            Training Outcomes
                        </h2>

                    </div>

                </div>

                <div class="outcome-content">

                    <div class="outcome-ring"
                         style="@($"--pass-rate:{_dashboard.PassRate}")">

                        <div>

                            <strong>
                                @($"{_dashboard.PassRate}%")
                            </strong>

                            <small>
                                Pass Rate
                            </small>

                        </div>

                    </div>

                    <div class="outcome-legend">

                        <div class="outcome-row">

                            <span class="legend-dot passed">
                            </span>

                            <span>
                                Passed
                            </span>

                            <strong>
                                @_dashboard.PassCount
                            </strong>

                        </div>

                        <div class="outcome-row">

                            <span class="legend-dot failed">
                            </span>

                            <span>
                                Failed
                            </span>

                            <strong>
                                @_dashboard.FailCount
                            </strong>

                        </div>

                    </div>

                </div>

            </article>

        </section>


        @* =====================================================
            TRAINING AREA PERFORMANCE
           ===================================================== *@

        <section class="dashboard-secondary-grid">

            <article class="dashboard-card">

                <div class="card-heading">

                    <div>

                        <span class="card-eyebrow">
                            COACHING PRIORITIES
                        </span>

                        <h2>
                            Training Area Performance
                        </h2>

                    </div>

                </div>


                <div class="metric-list">

                    <div class="metric">

                        <div class="metric-result">

                            <span>
                                Procedural Accuracy
                            </span>

                            <strong>
                                @($"{_dashboard.ScoreBreakdown.ProcedureAccuracy}%")
                            </strong>

                        </div>

                        <div class="metric-track">

                            <div class="metric-fill"
                                 style="@($"width:{_dashboard.ScoreBreakdown.ProcedureAccuracy}%")">
                            </div>

                        </div>

                    </div>


                    <div class="metric">

                        <div class="metric-result">

                            <span>
                                Decision Making
                            </span>

                            <strong>
                                @($"{_dashboard.ScoreBreakdown.DecisionMaking}%")
                            </strong>

                        </div>

                        <div class="metric-track">

                            <div class="metric-fill"
                                 style="@($"width:{_dashboard.ScoreBreakdown.DecisionMaking}%")">
                            </div>

                        </div>

                    </div>


                    <div class="metric">

                        <div class="metric-result">

                            <span>
                                Checklist Usage
                            </span>

                            <strong>
                                @($"{_dashboard.ScoreBreakdown.ChecklistUsage}%")
                            </strong>

                        </div>

                        <div class="metric-track">

                            <div class="metric-fill"
                                 style="@($"width:{_dashboard.ScoreBreakdown.ChecklistUsage}%")">
                            </div>

                        </div>

                    </div>


                    <div class="metric">

                        <div class="metric-result">

                            <span>
                                Time Management
                            </span>

                            <strong>
                                @($"{_dashboard.ScoreBreakdown.TimeManagement}%")
                            </strong>

                        </div>

                        <div class="metric-track">

                            <div class="metric-fill"
                                 style="@($"width:{_dashboard.ScoreBreakdown.TimeManagement}%")">
                            </div>

                        </div>

                    </div>


                    <div class="metric">

                        <div class="metric-result">

                            <span>
                                Communication
                            </span>

                            <strong>
                                @($"{_dashboard.ScoreBreakdown.Communication}%")
                            </strong>

                        </div>

                        <div class="metric-track">

                            <div class="metric-fill"
                                 style="@($"width:{_dashboard.ScoreBreakdown.Communication}%")">
                            </div>

                        </div>

                    </div>

                </div>

            </article>


            @* =================================================
                SCENARIO OUTCOMES
               ================================================= *@

            <article class="dashboard-card scenario-card">

                <div class="card-heading">

                    <div>

                        <span class="card-eyebrow">
                            SCENARIO ANALYSIS
                        </span>

                        <h2>
                            Scenario Outcomes
                        </h2>

                    </div>

                    <span class="card-stat">
                        @_dashboard.ScenarioOutcomes.Count scenarios
                    </span>

                </div>

                @if (_dashboard.ScenarioOutcomes.Count == 0)
                {
                    <div class="no-data">

                        <span>
                            ✈
                        </span>

                        <strong>
                            No scenario results
                        </strong>

                        <small>
                            Scenario outcomes will appear
                            after simulations are completed.
                        </small>

                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="dashboard-table">

                            <thead>

                                <tr>
                                    <th>Scenario</th>
                                    <th>Attempts</th>
                                    <th>Avg. Score</th>
                                    <th>Pass Rate</th>
                                    <th>Reaction</th>
                                    <th>Outcome</th>
                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var scenario in _dashboard.ScenarioOutcomes)
                                {
                                    <tr>

                                        <td>

                                            <strong>
                                                @scenario.ScenarioName
                                            </strong>

                                        </td>

                                        <td>
                                            @scenario.Attempts
                                        </td>

                                        <td>
                                            @($"{scenario.AverageScore}%")
                                        </td>

                                        <td>
                                            @($"{scenario.PassRate}%")
                                        </td>

                                        <td>
                                            @scenario.AverageReactionTime s
                                        </td>

                                        <td>

                                            <span class="status-pill @(scenario.PassRate >= 70 ? "passed" : "failed")">

                                                @scenario.Passes passed /
                                                @scenario.Failures failed

                                            </span>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </article>

        </section>


        @* =====================================================
            INDIVIDUAL PILOT PERFORMANCE
           ===================================================== *@

        @if (string.IsNullOrWhiteSpace(
            _dashboard.SelectedPilotUserId))
        {
            <section class="dashboard-full-width">

                <article class="dashboard-card">

                    <div class="card-heading">

                        <div>

                            <span class="card-eyebrow">
                                INDIVIDUAL ANALYSIS
                            </span>

                            <h2>
                                Pilot Performance
                            </h2>

                        </div>

                        <span class="card-stat">
                            @_dashboard.PilotPerformance.Count pilots
                        </span>

                    </div>

                    @if (_dashboard.PilotPerformance.Count == 0)
                    {
                        <div class="no-data">

                            <span>
                                👥
                            </span>

                            <strong>
                                No pilots available
                            </strong>

                            <small>
                                Linked pilots will appear here.
                            </small>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="dashboard-table pilot-table">

                                <thead>

                                    <tr>
                                        <th>Pilot</th>
                                        <th>Attempts</th>
                                        <th>Avg. Score</th>
                                        <th>Pass Rate</th>
                                        <th>Reaction Time</th>
                                        <th>Latest Training</th>
                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var pilot in _dashboard.PilotPerformance)
                                    {
                                        <tr>

                                            <td>

                                                <div class="pilot-cell">

                                                    <span class="pilot-avatar">
                                                        👨‍✈
                                                    </span>

                                                    <strong>
                                                        @pilot.PilotName
                                                    </strong>

                                                </div>

                                            </td>

                                            <td>
                                                @pilot.Attempts
                                            </td>

                                            <td>
                                                @($"{pilot.AverageScore}%")
                                            </td>

                                            <td>

                                                <span class="status-pill @(pilot.PassRate >= 70 ? "passed" : "failed")">
                                                    @($"{pilot.PassRate}%")
                                                </span>

                                            </td>

                                            <td>
                                                @pilot.AverageReactionTime s
                                            </td>

                                            <td>
                                                @(pilot.LatestAttempt.HasValue
                                                    ? pilot.LatestAttempt.Value
                                                        .ToLocalTime()
                                                        .ToString("dd MMM yyyy")
                                                    : "No training")
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </article>

            </section>
        }


        @* =====================================================
            RECENT TRAINING
           ===================================================== *@

        <section class="dashboard-full-width">

            <article class="dashboard-card">

                <div class="card-heading">

                    <div>

                        <span class="card-eyebrow">
                            RECENT ACTIVITY
                        </span>

                        <h2>
                            Recent Pilot Training
                        </h2>

                    </div>

                    <span class="card-stat">
                        Latest @_dashboard.RecentActivity.Count
                    </span>

                </div>

                @if (_dashboard.RecentActivity.Count == 0)
                {
                    <div class="no-data">

                        <span>
                            ◷
                        </span>

                        <strong>
                            No recent training
                        </strong>

                        <small>
                            Recent simulation results
                            will appear here.
                        </small>

                    </div>
                }
                else
                {
                    <div class="recent-activity-list">

                        @foreach (var activity in _dashboard.RecentActivity)
                        {
                            <div class="recent-activity-item">

                                <span class="activity-icon">
                                    ✈
                                </span>

                                <div class="activity-details">

                                    <strong>
                                        @activity.PilotName
                                    </strong>

                                    <span>
                                        @activity.ScenarioName
                                        ·
                                        @activity.AircraftName
                                    </span>

                                    <small>
                                        @activity.CompletedAt
                                            .ToLocalTime()
                                            .ToString(
                                                "dd MMM yyyy, HH:mm")
                                    </small>

                                </div>

                                <div class="activity-result">

                                    <strong>
                                        @($"{activity.OverallScore}%")
                                    </strong>

                                    <span class="status-pill @(activity.Passed ? "passed" : "failed")">

                                        @(activity.Passed
                                            ? "Passed"
                                            : "Failed")

                                    </span>

                                </div>

                            </div>
                        }

                    </div>
                }

            </article>

        </section>


        <footer class="dashboard-footer">

            <span class="live-indicator">
            </span>

            Dashboard values are calculated from
            recorded AeroResponse simulation results.

        </footer>

    </main>
}


@code {

    /*
     * =========================================================
     * TEMPORARY DEVELOPMENT SWITCH
     * =========================================================
     *
     * true:
     * Dashboard can be viewed without login and uses
     * all available simulation reports as preview data.
     *
     * false:
     * Dashboard requires an authenticated trainer/company
     * context and returns only linked pilots.
     *
     * When authentication is ready:
     *
     * 1. Change this to false.
     * 2. Uncomment @attribute [Authorize] at the top.
     */
    private const bool DevelopmentPreviewMode = true;


    private InstructorDashboardVm? _dashboard;

    private bool _loading = true;

    private int _selectedDays = 30;

    private string? _selectedPilotUserId;


    private string CurrentScopeLabel =>
        !string.IsNullOrWhiteSpace(
            _dashboard?.SelectedPilotName)
            ? _dashboard.SelectedPilotName
            : "All Linked Pilots";


    private string PeriodDescription =>
        _dashboard?.FromUtc is null
            ? "All recorded training activity"
            : $"{_dashboard.FromUtc.Value.ToLocalTime():dd MMM yyyy} " +
            $"to {_dashboard.ToUtc.ToLocalTime():dd MMM yyyy}";


    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }


    private async Task ChangePeriodAsync(
        ChangeEventArgs args)
    {
        if (!int.TryParse(
                args.Value?.ToString(),
                out var days))
        {
            return;
        }

        _selectedDays = days;

        await LoadAsync();
    }


    private async Task ChangePilotAsync(
        ChangeEventArgs args)
    {
        var value =
            args.Value?.ToString();

        _selectedPilotUserId =
            string.IsNullOrWhiteSpace(value)
                ? null
                : value;

        await LoadAsync();
    }


    private async Task LoadAsync()
    {
        try
        {
            _loading = true;

            var authenticationState =
                await AuthenticationStateProvider
                    .GetAuthenticationStateAsync();

            var principal =
                authenticationState.User;

            var userId =
                principal.FindFirstValue(
                    ClaimTypes.NameIdentifier);


            /*
             * DEVELOPMENT PREVIEW
             *
             * If no authenticated instructor exists yet,
             * display a dashboard using all available reports.
             */
            if (DevelopmentPreviewMode &&
                string.IsNullOrWhiteSpace(userId))
            {
                _dashboard =
                    await InstructorDashboardService
                        .GetDevelopmentPreviewAsync(
                            _selectedDays,
                            _selectedPilotUserId);

                return;
            }


            if (string.IsNullOrWhiteSpace(userId))
            {
                _dashboard =
                    InstructorDashboardVm
                        .Unauthorised();

                return;
            }


            _dashboard =
                await InstructorDashboardService
                    .GetDashboardAsync(
                        userId,
                        _selectedDays,
                        _selectedPilotUserId);


            /*
             * During development, allow the page to remain
             * visible even if the logged-in test account has
             * not yet been configured as a trainer.
             */
            if (DevelopmentPreviewMode &&
                !_dashboard.IsAuthorised)
            {
                _dashboard =
                    await InstructorDashboardService
                        .GetDevelopmentPreviewAsync(
                            _selectedDays,
                            _selectedPilotUserId);
            }
        }
        finally
        {
            _loading = false;
        }
    }


    private async Task DownloadReportAsync()
    {
        if (_dashboard is null ||
            !_dashboard.IsAuthorised)
        {
            return;
        }

        var scope =
            string.IsNullOrWhiteSpace(
                _dashboard.SelectedPilotName)
                ? "All-Pilots"
                : MakeFileNameSafe(
                    _dashboard.SelectedPilotName);

        var period =
            _selectedDays == 0
                ? "All-Time"
                : $"Last-{_selectedDays}-Days";

        var currentDate =
            DateTime.Now
                .ToString("yyyy-MM-dd");

        var fileName =
            $"AeroResponse-Instructor-{scope}-{period}-{currentDate}.pdf";

        await JS.InvokeVoidAsync(
            "aeroReports.downloadPdf",
            "instructor-performance-report",
            fileName);
    }


    private static string MakeFileNameSafe(
        string value)
    {
        foreach (var invalidCharacter in
                Path.GetInvalidFileNameChars())
        {
            value =
                value.Replace(
                    invalidCharacter,
                    '-');
        }

        return value.Replace(
            " ",
            "-");
    }
}