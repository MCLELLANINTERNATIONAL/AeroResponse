@page "/reports"
@rendermode InteractiveServer
@implements IDisposable
@using System.IO
@inject PerformanceDashboardService DashboardService
@inject IJSRuntime JS

<PageTitle>PILOT RESULTS DASHBOARD</PageTitle>

@* =========================================================
LOADING STATE
========================================================= *@

@if (_loading)
{
    <div class="reports-loading">
        Loading pilot performance…
    </div>
}

@* =========================================================
EMPTY DASHBOARD STATE
========================================================= *@

else if (_dashboard?.Latest is null)
{
    <div class="reports-empty">
        <h1>No results yet</h1>
        <p>Complete a practice scenario to populate this dashboard.</p>
    </div>
}

@* =========================================================
MAIN DASHBOARD
========================================================= *@

else
{
    var report = _dashboard.Latest;

    <main id="pilot-performance-report" class="reports-page">

        @* =====================================================
        DASHBOARD HEADER
        ===================================================== *@

        <header class="reports-header">
            <div>
                <h1>PILOT RESULTS DASHBOARD</h1>
                <p>Review your performance and achievements</p>
            </div>

            <div class="pilot-chip">
                <span class="pilot-avatar">✈</span>

                <div>
                    <strong>@report.PilotName</strong>
                    <small>Professional Pilot</small>
                </div>
            </div>
        </header>

        @* =====================================================
        DASHBOARD NAVIGATION
        ===================================================== *@

        <nav class="reports-tabs">
            <NavLink href="/reports" Match="NavLinkMatch.All">
                ◉ Overview
            </NavLink>

            <NavLink href="/reports/flight-logs">
                ✈ Flight Logs
            </NavLink>

            <NavLink href="/reports/scoring">
                ⚙ Scoring
            </NavLink>

            <NavLink href="/reports/analytics">
                ▥ Analytics
            </NavLink>

            <NavLink href="/reports/feedback">
                ✪ Feedback
            </NavLink>

            <NavLink href="/reports/badges">
                🏆 Badges
            </NavLink>

            <NavLink href="/reports/instructor">
                👨‍✈ Instructor Reports
            </NavLink>

            <NavLink href="/reports/admin">
                ▦ Admin Reports
            </NavLink>
            
            <button id="download-report-button"
                type="button"
                @onclick="DownloadReportAsync">
                ⬇ Download PDF
            </button>
        </nav>

    @* =====================================================
    TOP DASHBOARD GRID
    ===================================================== *@

    <section id="overview" class="reports-grid top-grid">

        @* =================================================
        OVERALL SCORE CARD
        ================================================= *@

        <article class="report-card score-card">
            <h2>Overall Score</h2>

            <div class="score-main">

                <div class="score-ring"
                style="--score:@report.OverallScore">

                <span>@report.OverallScore%</span>

                <small>
                    @(report.OverallScore >= 70
                    ? "Great Performance!"
                    : "Keep Practising")
                </small>
            </div>

            <div class="score-copy">
                <small>Total Score</small>
                <strong>@(report.OverallScore * 10) / 1000</strong>

                <small>Passing Score</small>
                <b>70% (700/1000)</b>

                <small>Rank</small>
                <strong>Top @RankPercent%</strong>
                <em>of all users</em>
            </div>
        </div>

        <div class="pass-banner">
            🏆

            <span>
                <strong>
                    @(report.OverallScore >= 70
                    ? "You passed this scenario!"
                    : "Scenario not yet passed")
                </strong>

                <small>
                    @(report.OverallScore >= 70
                    ? "Keep up the great work."
                    : "Review feedback and try again.")
                </small>
            </span>
        </div>
    </article>

    @* =================================================
    SCORE BREAKDOWN CARD
    ================================================= *@

    <article id="scoring" class="report-card">
        <h2>Score Breakdown</h2>

        <div class="metric">
            <div class="metric-result">
                <span>Procedural Accuracy</span>
                <strong>@report.ChecklistAccuracyScore%</strong>
            </div>

            <div class="metric-track">
                <div class="metric-fill blue"
                style="width: @report.ChecklistAccuracyScore%;">
            </div>
        </div>
    </div>

    <div class="metric">
        <div class="metric-result">
            <span>Decision Making</span>
            <strong>@report.DecisionMakingScore%</strong>
        </div>

        <div class="metric-track">
            <div class="metric-fill green"
            style="width: @report.DecisionMakingScore%;">
        </div>
    </div>
</div>

<div class="metric">
    <div class="metric-result">
        <span>Checklist Usage</span>
        <strong>@report.ChecklistUsageScore%</strong>
    </div>

    <div class="metric-track">
        <div class="metric-fill orange"
        style="width: @report.ChecklistUsageScore%;">
    </div>
</div>
</div>

<div class="metric">
    <div class="metric-result">
        <span>Time Management</span>
        <strong>@report.TimeManagementScore%</strong>
    </div>

    <div class="metric-track">
        <div class="metric-fill purple"
        style="width: @report.TimeManagementScore%;">
    </div>
</div>
</div>

<div class="metric">
    <div class="metric-result">
        <span>Communication</span>
        <strong>@report.CommunicationScore%</strong>
    </div>

    <div class="metric-track">
        <div class="metric-fill cyan"
        style="width: @report.CommunicationScore%;">
    </div>
</div>
</div>

<a class="card-link" href="#analytics">
    View scoring details →
</a>
</article>


@* =================================================
SCENARIO SUMMARY CARD
================================================= *@

<article class="report-card scenario-summary">
    <h2>Scenario Summary</h2>

    <div class="scenario-title">
        <span>✈</span>

        <div>
            <strong>@report.ScenarioName</strong>

            <small>
                Completed on:
                @(report.CompletedAt
                .ToLocalTime()
                .ToString("dd MMM yyyy 'at' HH:mm"))
            </small>

            <small>
                Scenario Difficulty: @report.Difficulty
            </small>
        </div>

        <b>EMERGENCY</b>
    </div>

    <hr />

    @InfoRow(
    "◷",
    "Reaction Time",
    $"{report.ReactionTimeSeconds}s")

    @InfoRow(
    "◷",
    "Total Time",
    Duration(report))

    @InfoRow(
    "◷",
    "Start Time",
    report.StartedAt
    .ToLocalTime()
    .ToString("HH:mm:ss"))

    @InfoRow(
    "◷",
    "End Time",
    report.CompletedAt
    .ToLocalTime()
    .ToString("HH:mm:ss"))

    @InfoRow(
    "☑",
    "Actions Taken",
    report.ActionsTaken.ToString())

    @InfoRow(
    "▣",
    "Checklist Used",
    $"{report.ChecklistUsageScore}%")
</article>

</section>

@* =====================================================
BOTTOM DASHBOARD GRID
===================================================== *@

<section class="reports-grid bottom-grid">

    @* =================================================
    PERFORMANCE ANALYTICS CARD
    ================================================= *@

    <article id="analytics"
    class="report-card analytics-card">

    <div class="card-heading">
        <h2>Performance Analytics</h2>
        <span>Last 10 Scenarios</span>
    </div>

    <svg class="trend-chart"
    viewBox="0 0 620 260"
    role="img"
    aria-label="Pilot performance trend">

    <g class="grid-lines">
        @for (var y = 0; y <= 4; y++)
        {
            <line x1="45"
            y1="@(25 + y * 48)"
            x2="600"
            y2="@(25 + y * 48)" />
        }
    </g>

    <polyline class="average-line"
    points="@AveragePoints" />

    <polyline class="score-line"
    points="@ScorePoints" />

    @foreach (var point in ChartPoints)
    {
        <circle cx="@point.X"
        cy="@point.Y"
        r="4" />
    }
</svg>

<div class="chart-legend">
    <span>● Your Score</span>
    <span>● Average Score</span>
</div>

<div class="stat-row">
    <div>
        <small>Average Score</small>
        <strong>@_dashboard.AverageScore%</strong>
    </div>

    <div>
        <small>Best Score</small>
        <strong>@_dashboard.BestScore%</strong>
    </div>

    <div>
        <small>Total Scenarios</small>
        <strong>@_dashboard.Reports.Count</strong>
    </div>

    <div>
        <small>Improvement</small>

        <strong class="positive">
            @Signed(_dashboard.Improvement)%
        </strong>
    </div>
</div>
</article>

@* =================================================
FEEDBACK CARD
================================================= *@

<article id="feedback"
class="report-card feedback-card">

<h2>Feedback</h2>

<div class="feedback-tabs"
     role="tablist"
     aria-label="Feedback type">

    <button type="button"
            role="tab"
            aria-selected="@(_activeFeedbackTab == FeedbackTab.Instructor)"
            class="@GetFeedbackTabClass(FeedbackTab.Instructor)"
            @onclick="() => SelectFeedbackTab(FeedbackTab.Instructor)">
        Instructor Feedback
    </button>

    <button type="button"
            role="tab"
            aria-selected="@(_activeFeedbackTab == FeedbackTab.Ai)"
            class="@GetFeedbackTabClass(FeedbackTab.Ai)"
            @onclick="() => SelectFeedbackTab(FeedbackTab.Ai)">
        AI Feedback
    </button>

</div>

@if (_activeFeedbackTab == FeedbackTab.Instructor)
{
    <section class="feedback-tab-content"
             role="tabpanel">

        <div class="@GetInstructorFeedbackClass(report)">
            <strong>
                @GetInstructorHeading(report)
            </strong>

            <p>
                @report.Feedback
            </p>
        </div>

        <h3>Areas to Improve</h3>

        <ul>
            @foreach (var item in ImprovementItems(report))
            {
                <li>@item</li>
            }
        </ul>

        <a class="card-link"
           href="/reports/feedback">
            View full instructor feedback →
        </a>

    </section>
}
else
{
    <section class="feedback-tab-content"
             role="tabpanel">

        <div class="feedback-ai">

            <h3>AI Performance Analysis</h3>

            @if (string.IsNullOrWhiteSpace(report.AiFeedback))
            {
                <p>
                    No AI-generated analysis is available
                    for this assessment.
                </p>
            }
            else
            {
                <p>
                    @report.AiFeedback
                </p>
            }

        </div>

        <h3>AI Recommended Focus</h3>

        <ul>
            @foreach (var item in AiImprovementItems(report))
            {
                <li>@item</li>
            }
        </ul>

        <a class="card-link"
           href="/reports/feedback">
            View full AI feedback →
        </a>

    </section>
}

</article>

@* =================================================
BADGES AND ACHIEVEMENTS CARD
================================================= *@

<article id="badges"
class="report-card badges-card">

<div class="card-heading">
    <h2>Badges Earned</h2>
    <span>@_dashboard.Achievements.Count earned</span>
</div>

<div class="badges-grid">

    @foreach (var badge in _dashboard.Achievements)
    {
        <div class="badge">
            <div class="badge-icon">
                @badge.Icon
            </div>

            <strong>@badge.Name</strong>

            <small>
                Earned:
                @(badge.EarnedAt
                .ToLocalTime()
                .ToString("dd MMM yyyy"))
            </small>
        </div>
    }

    <div class="badge locked">
        <div class="badge-icon">🔒</div>

        <strong>Perfect Score</strong>

        <small>
            Score 100% in any scenario
        </small>
    </div>
</div>
</article>

</section>

@* =====================================================
LIVE DASHBOARD STATUS
===================================================== *@

<p class="live-note">
    ● Live dashboard — refreshes automatically when a pilot
    completes a practice scenario.
</p>

</main>
}

@code {
    // =========================================================
    // DEVELOPMENT USER
    // =========================================================

    /*
     * TODO:
     * Replace this with the authenticated user's ID
     * once authentication is completed.
     */
    private const string UserId = "debug-pilot";


    // =========================================================
    // DASHBOARD STATE
    // =========================================================

    private PerformanceDashboardVm? _dashboard;

    private bool _loading = true;

    private ReportTab _activeReportTab =
        ReportTab.Overview;

    private FeedbackTab _activeFeedbackTab =
        FeedbackTab.Instructor;


    // =========================================================
    // INITIALIZATION
    // =========================================================

    protected override async Task OnInitializedAsync()
    {
        PerformanceFeed.ReportSaved +=
            OnReportSaved;

        await LoadAsync();
    }


    // =========================================================
    // DATABASE
    // =========================================================

    private async Task LoadAsync()
    {
        try
        {
            _loading = true;

            _dashboard =
                await DashboardService
                    .GetDashboardAsync(
                        UserId);
        }
        finally
        {
            _loading = false;
        }
    }


    private async void OnReportSaved(
        string userId)
    {
        if (!string.Equals(
                userId,
                UserId,
                StringComparison.Ordinal))
        {
            return;
        }

        await InvokeAsync(
            async () =>
            {
                await LoadAsync();

                StateHasChanged();
            });
    }


    // =========================================================
    // MAIN REPORT TABS
    // =========================================================

    private void SelectReportTab(
        ReportTab tab)
    {
        _activeReportTab =
            tab;
    }


    private string GetReportTabClass(
        ReportTab tab)
    {
        return _activeReportTab ==
            tab
                ? "active"
                : string.Empty;
    }


    // =========================================================
    // FEEDBACK SUB-TABS
    // =========================================================

    private void SelectFeedbackTab(
        FeedbackTab tab)
    {
        _activeFeedbackTab =
            tab;
    }


    private string GetFeedbackTabClass(
        FeedbackTab tab)
    {
        return _activeFeedbackTab ==
            tab
                ? "feedback-tab-button active"
                : "feedback-tab-button";
    }


    // =========================================================
    // SCORE DISPLAY
    // =========================================================

    private static RenderFragment ScoreMetric(
        string label,
        int score,
        string colorClass) =>
        builder =>
        {
            var sequence = 0;

            builder.OpenElement(
                sequence++,
                "div");

            builder.AddAttribute(
                sequence++,
                "class",
                "metric");


            builder.OpenElement(
                sequence++,
                "div");

            builder.AddAttribute(
                sequence++,
                "class",
                "metric-result");


            builder.OpenElement(
                sequence++,
                "span");

            builder.AddContent(
                sequence++,
                label);

            builder.CloseElement();


            builder.OpenElement(
                sequence++,
                "strong");

            builder.AddContent(
                sequence++,
                $"{score}%");

            builder.CloseElement();

            builder.CloseElement();


            builder.OpenElement(
                sequence++,
                "div");

            builder.AddAttribute(
                sequence++,
                "class",
                "metric-track");


            builder.OpenElement(
                sequence++,
                "div");

            builder.AddAttribute(
                sequence++,
                "class",
                $"metric-fill {colorClass}");

            builder.AddAttribute(
                sequence++,
                "style",
                $"width: {score}%");

            builder.CloseElement();

            builder.CloseElement();

            builder.CloseElement();
        };


    private int RankPercent =>
        Math.Max(
            1,
            100 -
            (_dashboard?.Latest?.OverallScore ?? 0));


    private static MarkupString InfoRow(
        string icon,
        string label,
        string value)
    {
        return new MarkupString(
            $"""
            <div class="info-row">
                <span>{icon}</span>
                <label>{label}</label>
                <strong>{value}</strong>
            </div>
            """);
    }


    private static string Duration(
        SimulationReport report)
    {
        var duration =
            report.CompletedAt -
            report.StartedAt;

        if (duration < TimeSpan.Zero)
        {
            return "00:00";
        }

        return duration.ToString(
            @"mm\:ss");
    }


    // =========================================================
    // ANALYTICS
    // =========================================================

    private IReadOnlyList<(double X, double Y)>
        ChartPoints
    {
        get
        {
            var reports =
                _dashboard?.ChartReports;

            if (reports is null ||
                reports.Count == 0)
            {
                return Array.Empty<
                    (double X, double Y)>();
            }

            return reports
                .Select(
                    (item, index) =>
                    {
                        var denominator =
                            Math.Max(
                                1,
                                reports.Count - 1);

                        var x =
                            45 +
                            index *
                            (555.0 / denominator);

                        var score =
                            Math.Clamp(
                                item.OverallScore,
                                0,
                                100);

                        var y =
                            217 -
                            score *
                            1.8;

                        return (
                            X: x,
                            Y: y);
                    })
                .ToList();
        }
    }


    private string ScorePoints =>
        string.Join(
            " ",
            ChartPoints.Select(
                point =>
                    $"{point.X:F1},{point.Y:F1}"));


    private string AveragePoints =>
        string.Join(
            " ",
            ChartPoints.Select(
                (point, index) =>
                {
                    var averageScore =
                        Math.Clamp(
                            55 + index * 2,
                            0,
                            100);

                    var y =
                        217 -
                        averageScore *
                        1.8;

                    return
                        $"{point.X:F1},{y:F1}";
                }));


    private static string Signed(
        int number)
    {
        return number >= 0
            ? $"+{number}"
            : number.ToString();
    }


    // =========================================================
    // FEEDBACK
    // =========================================================

    private static IEnumerable<string>
        ImprovementItems(
            SimulationReport report)
    {
        var hasImprovementItem =
            false;

        if (report.ReactionTimeSeconds > 10)
        {
            hasImprovementItem = true;

            yield return
                $"Improve time to identify the primary failure " +
                $"({report.ReactionTimeSeconds - 10}s slower than target).";
        }

        if (report.CommunicationScore < 90)
        {
            hasImprovementItem = true;

            yield return
                "Consider declaring the emergency and requesting " +
                "assistance earlier.";
        }

        if (report.ChecklistAccuracyScore < 95)
        {
            hasImprovementItem = true;

            yield return
                "Maintain checklist discipline when workload increases.";
        }

        if (report.SafetyCriticalErrors > 0)
        {
            hasImprovementItem = true;

            yield return
                "Review safety-critical actions before the next attempt.";
        }

        if (!hasImprovementItem)
        {
            yield return
                "Continue maintaining the same high standard " +
                "in future scenarios.";
        }
    }


    private static string GetInstructorHeading(
        SimulationReport report)
    {
        if (report.ActionsTaken == 0)
        {
            return "Review Required";
        }

        if (!report.Passed)
        {
            return "Further Practice Required";
        }

        return report.OverallScore >= 85
            ? "☆ Great Job!"
            : "Good Attempt";
    }


    private static string GetInstructorFeedbackClass(
        SimulationReport report)
    {
        return report.ActionsTaken == 0 ||
               !report.Passed
            ? "feedback-good feedback-review"
            : "feedback-good";
    }


    private static IEnumerable<string>
        AiImprovementItems(
            SimulationReport report)
    {
        var hasRecommendation =
            false;

        if (report.ActionsTaken == 0)
        {
            hasRecommendation = true;

            yield return
                "Begin the response immediately after the emergency warning appears.";
        }

        if (report.ProcedureAccuracyScore < 85)
        {
            hasRecommendation = true;

            yield return
                "Review the gold-standard procedure and practise the exact action sequence.";
        }

        if (report.TimeManagementScore < 80)
        {
            hasRecommendation = true;

            yield return
                "Reduce the delay between the warning and the first cockpit action.";
        }

        if (report.DecisionMakingScore < 80)
        {
            hasRecommendation = true;

            yield return
                "Prioritise safety-critical actions before secondary tasks.";
        }

        if (report.CommunicationScore < 90)
        {
            hasRecommendation = true;

            yield return
                "Declare the emergency and communicate intentions earlier.";
        }

        if (report.SafetyCriticalErrors > 0)
        {
            hasRecommendation = true;

            yield return
                "Repeat the safety-critical memory actions before attempting the scenario again.";
        }

        if (!hasRecommendation)
        {
            yield return
                "Maintain the current standard and practise at a higher difficulty level.";
        }
    }


    // =========================================================
    // PDF
    // =========================================================

    private async Task DownloadReportAsync()
    {
        if (_dashboard?.Latest is null)
        {
            return;
        }

        var report =
            _dashboard.Latest;

        var pilotName =
            MakeFileNameSafe(
                report.PilotName);

        var scenarioName =
            MakeFileNameSafe(
                report.ScenarioName);

        var completedDate =
            report.CompletedAt
                .ToLocalTime()
                .ToString(
                    "yyyy-MM-dd");

        var fileName =
            $"AeroResponse-" +
            $"{pilotName}-" +
            $"{scenarioName}-" +
            $"{completedDate}.pdf";

        await JS.InvokeVoidAsync(
            "aeroReports.downloadPdf",
            "pilot-performance-report",
            fileName);
    }


    private static string MakeFileNameSafe(
        string value)
    {
        if (string.IsNullOrWhiteSpace(
            value))
        {
            return "Report";
        }

        foreach (var invalidCharacter
                 in Path.GetInvalidFileNameChars())
        {
            value =
                value.Replace(
                    invalidCharacter,
                    '-');
        }

        return value
            .Replace(
                ' ',
                '-')
            .Trim('-');
    }


    private enum ReportTab
    {
        Overview,
        FlightLogs,
        Scoring,
        Analytics,
        Feedback,
        Badges
    }


    private enum FeedbackTab
    {
        Instructor,
        Ai
    }


    public void Dispose()
    {
        PerformanceFeed.ReportSaved -=
            OnReportSaved;
    }
}