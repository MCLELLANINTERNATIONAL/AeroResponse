<div class="engine-status">
    <svg viewBox="0 0 300 300"
            class="fire-detection-svg"
            role="img"
            aria-label="@GetStatusText(Status)">
        <text x="75"
                y="30"
                text-anchor="middle"
                class="fire-subtext">
            @Label
        </text>
        <circle cx="75"
                cy="65"
                r="27"
                class="@GetCircleClass(Status)" />

        <text x="75"
                y="107"
                text-anchor="middle"
                class="fire-subtext">
            @GetStatusText(Status)
        </text>
    </svg>
</div>

@code {
    [Parameter]
    public FireDetectionStatus Status { get; set; }
        = FireDetectionStatus.Normal;

    [Parameter]
    public string Label { get; set; }
        = "Fire Detection";

    private static string GetCircleClass(
        FireDetectionStatus status) => status switch
    {
        FireDetectionStatus.Normal =>
            "fire-circle normal",

        FireDetectionStatus.Caution =>
            "fire-circle caution",

        FireDetectionStatus.Warning =>
            "fire-circle warning",

        FireDetectionStatus.Suppressed =>
            "fire-circle suppressed",

        FireDetectionStatus.Extinguished =>
            "fire-circle extinguished",

        _ =>
            "fire-circle warning"
    };

    private static string GetStatusText(
        FireDetectionStatus status) => status switch
    {
        FireDetectionStatus.Normal => "NORMAL",
        FireDetectionStatus.Caution => "SMOKE",
        FireDetectionStatus.Warning => "FIRE",
        FireDetectionStatus.Suppressed => "SUPPRESS",
        FireDetectionStatus.Extinguished => "OUT",
        _ => "UNKNOWN"
    };
}