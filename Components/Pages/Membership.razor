    private sealed record Benefit(
        string Icon,
        string Title,
        string Description
    );

    private sealed record Plan(
        string Name,
        string Summary,
        decimal MonthlyPrice,
        string Icon,
        string AccentClass,
        string[] Features,
        string ButtonText,
        string Link,
        bool Featured
